@page
@model ClinicManagementSystem.Pages.Doctor.DoctorDashboardModel
@{
    Layout = "_DoctorLayout";
    ViewData["Title"] = "Doctor Dashboard - MediCore";
}

<style>
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    .top-bar {
        background: white;
        border-radius: 12px;
        padding: 20px 25px;
        margin-bottom: 25px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        box-shadow: 0 2px 5px rgba(0,0,0,0.05);
    }

    .welcome-text h1 {
        font-size: 24px;
        color: #1a56db;
        margin-bottom: 5px;
    }

    .welcome-text p {
        color: #6c757d;
        font-size: 14px;
    }

    .doctor-name {
        font-size: 16px;
        font-weight: 600;
        color: #1a56db;
        text-align: right;
    }

    .doctor-specialty {
        font-size: 12px;
        color: #6c757d;
        text-align: right;
    }

    .date-time {
        background: #e8f0fe;
        padding: 8px 15px;
        border-radius: 8px;
        font-size: 13px;
        color: #1a56db;
        margin-top: 5px;
        text-align: center;
    }

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 20px;
        margin-bottom: 25px;
    }

    .stat-card {
        background: white;
        border-radius: 12px;
        padding: 20px;
        box-shadow: 0 2px 5px rgba(0,0,0,0.05);
        display: flex;
        justify-content: space-between;
        align-items: center;
        cursor: pointer;
        transition: transform 0.2s;
    }

        .stat-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 5px 15px rgba(0,0,0,0.1);
        }

    .stat-info h3 {
        font-size: 28px;
        color: #1a56db;
        margin-bottom: 5px;
    }

    .stat-info p {
        color: #6c757d;
        font-size: 13px;
    }

    .stat-icon i {
        font-size: 32px;
        color: #1a56db;
        opacity: 0.5;
    }

    .quick-links {
        display: flex;
        gap: 20px;
        margin-bottom: 25px;
        flex-wrap: wrap;
    }

    .quick-link {
        background: white;
        border-radius: 10px;
        padding: 12px 20px;
        text-decoration: none;
        color: #1a56db;
        font-weight: 600;
        font-size: 14px;
        box-shadow: 0 2px 5px rgba(0,0,0,0.05);
        transition: all 0.2s;
    }

        .quick-link:hover {
            background: #1a56db;
            color: white;
        }

    .two-columns {
        display: flex;
        gap: 25px;
        margin-bottom: 25px;
    }

    .left-column {
        flex: 2;
    }

    .right-column {
        flex: 1;
    }

    .card {
        background: white;
        border-radius: 12px;
        box-shadow: 0 2px 5px rgba(0,0,0,0.05);
        overflow: hidden;
        margin-bottom: 25px;
    }

    .card-header {
        padding: 18px 20px;
        border-bottom: 1px solid #e8f0fe;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

        .card-header h3 {
            font-size: 16px;
            color: #2d3748;
        }

        .card-header a {
            color: #1a56db;
            text-decoration: none;
            font-size: 13px;
        }

    .prescription-table, .followup-table, .disease-table {
        width: 100%;
        border-collapse: collapse;
    }

        .prescription-table th, .followup-table th, .disease-table th {
            text-align: left;
            padding: 12px 15px;
            background: #f8f9fa;
            font-size: 12px;
            color: #6c757d;
            font-weight: 600;
            border-bottom: 1px solid #e8f0fe;
        }

        .prescription-table td, .followup-table td, .disease-table td {
            padding: 12px 15px;
            border-bottom: 1px solid #e8f0fe;
            font-size: 13px;
        }

    .status-upcoming {
        color: #f39c12;
        font-weight: 600;
    }

    .view-link {
        text-align: center;
        padding: 12px;
        border-top: 1px solid #e8f0fe;
    }

        .view-link a {
            color: #1a56db;
            text-decoration: none;
            font-size: 13px;
        }

    .footer {
        background: white;
        border-radius: 12px;
        padding: 15px 20px;
        text-align: center;
        font-size: 11px;
        color: #a0aec0;
        margin-top: 20px;
    }

    .trend-up {
        color: #e53e3e;
        font-weight: 600;
    }

    .trend-down {
        color: #27ae60;
        font-weight: 600;
    }

    .trend-stable {
        color: #6c757d;
    }

    .disease-badge {
        display: inline-block;
        padding: 4px 10px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 600;
    }

    .disease-high {
        background: #fee2e2;
        color: #e53e3e;
    }

    .disease-medium {
        background: #fff3e0;
        color: #f39c12;
    }

    .disease-low {
        background: #e8fce8;
        color: #27ae60;
    }

    .progress-bar {
        background: #e8f0fe;
        border-radius: 10px;
        overflow: hidden;
        margin-top: 3px;
    }

    .progress-fill {
        background: #1a56db;
        height: 6px;
        border-radius: 10px;
        transition: width 0.3s ease;
    }

    .no-data {
        text-align: center;
        padding: 40px;
        color: #6c757d;
    }

    media (max-width: 1200px) {
        .two-columns {
            flex-direction: column;
        }

        .stats-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    media (max-width: 768px) {
        .top-bar {
            flex-direction: column;
            text-align: center;
        }

        .doctor-name, .doctor-specialty {
            text-align: center;
        }

        .stats-grid {
            grid-template-columns: 1fr;
        }

        .quick-links {
            justify-content: center;
        }
    }
</style>

<div class="top-bar">
    <div class="welcome-text">
        <h1>Welcome back, @Model.DoctorName!</h1>
        <p>@Model.Specialization</p>
        <p>Here's what's happening in your clinic today.</p>
    </div>
    <div>
        <div class="doctor-name">@Model.DoctorName</div>
        <div class="doctor-specialty">@Model.Specialization | @Model.ClinicName</div>
        <div class="date-time" id="dateTime"></div>
    </div>
</div>

<div class="stats-grid">
    <div class="stat-card" onclick="window.location.href='/Doctor/ViewAppointments'">
        <div class="stat-info">
            <h3>@Model.TodayAppointmentsCount</h3>
            <p>Today's Appointments</p>
        </div>
        <div class="stat-icon">
            <i class="fas fa-calendar-day"></i>
        </div>
    </div>
    <div class="stat-card" onclick="window.location.href='/Doctor/Prescription'">
        <div class="stat-info">
            <h3>@Model.TodayPrescriptionsCount</h3>
            <p>Prescriptions Today</p>
        </div>
        <div class="stat-icon">
            <i class="fas fa-prescription"></i>
        </div>
    </div>
    <div class="stat-card" onclick="window.location.href='/Doctor/FollowUp'">
        <div class="stat-info">
            <h3>@Model.PendingFollowUpsCount</h3>
            <p>Pending Follow-Ups</p>
        </div>
        <div class="stat-icon">
            <i class="fas fa-clock"></i>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-info">
            <h3>@Model.PatientsThisMonthCount</h3>
            <p>Patients This Month</p>
        </div>
        <div class="stat-icon">
            <i class="fas fa-users"></i>
        </div>
    </div>
</div>

<div class="quick-links">
    <a href="/Doctor/ViewAppointments" class="quick-link"><i class="fas fa-calendar-alt"></i> View Appointments</a>
    <a href="/Doctor/Prescription" class="quick-link"><i class="fas fa-prescription"></i> Write Prescription</a>
    <a href="/Doctor/FollowUp" class="quick-link"><i class="fas fa-clock"></i> View Follow-Ups</a>
</div>

<div class="two-columns">
    <div class="left-column">
        <div class="card">
            <div class="card-header">
                <h3><i class="fas fa-prescription"></i> Recent Prescriptions</h3>
                <a href="/Doctor/Prescription">View all →</a>
            </div>
            <table class="prescription-table">
                <thead>
                    <tr>
                        <th>Patient Name</th>
                        <th>Date</th>
                        <th>Diagnosis</th>
                        <th>Medicines</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.RecentPrescriptions != null && Model.RecentPrescriptions.Any())
                    {
                        @foreach (var pres in Model.RecentPrescriptions)
                        {
                            int medicineCount = pres.PrescribedMedicines != null ? pres.PrescribedMedicines.Count : 0;
                            <tr>
                                <td>
                                    <strong>@(pres.Patient?.Name ?? "Unknown")</strong><br />
                                    <span style="font-size: 11px; color: #6c757d;">ID: @pres.PatientId</span>
                                </td>
                                <td>
                                    @pres.VisitDate.ToString("dd MMM yyyy")<br />
                                    <span style="font-size: 11px; color: #6c757d;">@pres.VisitDate.ToString("hh:mm tt")</span>
                                </td>
                                <td>@(pres.Diagnosis?.Length > 30 ? pres.Diagnosis.Substring(0, 30) + "..." : pres.Diagnosis ?? "N/A")</td>
                                <td>@medicineCount medicine(s)</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="no-data">
                                <i class="fas fa-info-circle"></i> No prescriptions yet
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            <div class="view-link">
                <a href="/Doctor/Prescription">Write New Prescription →</a>
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <h3><i class="fas fa-clock"></i> Follow-Ups Due</h3>
                <a href="/Doctor/FollowUp">View all →</a>
            </div>
            <table class="followup-table">
                <thead>
                    <tr>
                        <th>Patient Name</th>
                        <th>Follow-Up Date</th>
                        <th>Diagnosis</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.FollowUpsDue != null && Model.FollowUpsDue.Any())
                    {
                        @foreach (var pres in Model.FollowUpsDue)
                        {
                            var isOverdue = pres.FollowUpDate?.Date < DateTime.Today.Date;
                            <tr>
                                <td>
                                    <strong>@(pres.Patient?.Name ?? "Unknown")</strong><br />
                                    <span style="font-size: 11px; color: #6c757d;">@(pres.Patient?.Phone ?? "No phone")</span>
                                </td>
                                <td>
                                    @(pres.FollowUpDate?.ToString("dd MMM yyyy") ?? "Not set")<br />
                                    <span style="font-size: 11px; color: @(isOverdue ? "#e53e3e" : "#6c757d");">
                                        @(isOverdue ? "Overdue" : "Upcoming")
                                    </span>
                                </td>
                                <td>@(pres.Diagnosis?.Length > 25 ? pres.Diagnosis.Substring(0, 25) + "..." : pres.Diagnosis ?? "N/A")</td>
                                <td class="status-upcoming">@(isOverdue ? "Urgent" : "Scheduled")</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="no-data">
                                <i class="fas fa-check-circle"></i> No follow-ups due
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            <div class="view-link">
                <a href="/Doctor/FollowUp">Manage Follow-Ups →</a>
            </div>
        </div>
    </div>

    <div class="right-column">
        <div class="card">
            <div class="card-header">
                <h3><i class="fas fa-chart-line"></i> Current Disease Trends</h3>
                <span style="font-size: 11px; color: #6c757d;">Last 30 days</span>
            </div>
            <table class="disease-table">
                <thead>
                    <tr>
                        <th>Disease</th>
                        <th>Patients</th>
                        <th>Trend</th>
                        <th>Common Symptoms</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.DiseaseTrends != null && Model.DiseaseTrends.Any())
                    {
                        int maxCount = Model.DiseaseTrends.Max(d => d.OccurrenceCount);
                        @foreach (var disease in Model.DiseaseTrends)
                        {
                            string diseaseClass = disease.OccurrenceCount >= 10 ? "disease-high" :
                                                 (disease.OccurrenceCount >= 5 ? "disease-medium" : "disease-low");
                            string trendClass = disease.Trend.Contains("Increasing") ? "trend-up" :
                                               (disease.Trend.Contains("Decreasing") ? "trend-down" : "trend-stable");
                            string trendIcon = disease.Trend.Contains("Increasing") ? "↑" :
                                              (disease.Trend.Contains("Decreasing") ? "↓" : "→");
                            int percentage = maxCount > 0 ? (int)((disease.OccurrenceCount / (double)maxCount) * 100) : 0;

                            <tr>
                                <td>
                                    <span class="disease-badge @diseaseClass">@disease.DiseaseName</span>
                                </td>
                                <td style="min-width: 80px;">
                                    <strong>@disease.OccurrenceCount</strong> patients
                                    <div class="progress-bar">
                                        <div class="progress-fill" style="width: @percentage%;"></div>
                                    </div>
                                </td>
                                <td class="@trendClass">@trendIcon @disease.Trend</td>
                                <td style="max-width: 180px;">@disease.CommonSymptoms</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="no-data">
                                <i class="fas fa-chart-line"></i> No disease data available yet.<br />Start adding prescriptions to see trends.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            @if (Model.DiseaseDistribution != null && Model.DiseaseDistribution.Any())
            {
                <div style="padding: 15px 20px; border-top: 1px solid #e8f0fe; background: #f8f9fa;">
                    <h4 style="font-size: 13px; margin-bottom: 12px; color: #2d3748;">
                        <i class="fas fa-chart-pie"></i> Disease Distribution
                    </h4>
                    @{
                        int totalPatients = Model.DiseaseDistribution.Sum(d => d.Value);
                    }
                    @foreach (var dist in Model.DiseaseDistribution)
                    {
                        double percentage = totalPatients > 0 ? (dist.Value / (double)totalPatients) * 100 : 0;
                        <div style="margin-bottom: 12px;">
                            <div style="display: flex; justify-content: space-between; font-size: 12px; margin-bottom: 4px;">
                                <span><strong>@dist.Key</strong></span>
                                <span>@dist.Value patients (@percentage.ToString("F0")%)</span>
                            </div>
                            <div style="background: #e8f0fe; border-radius: 10px; overflow: hidden;">
                                <div style="background: linear-gradient(90deg, #1a56db, #3b82f6); width: @percentage%; height: 8px; border-radius: 10px;"></div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        <div class="card">
            <div class="card-header">
                <h3><i class="fas fa-lightbulb"></i> Quick Tips</h3>
            </div>
            <div style="padding: 15px 20px;">
                <div style="margin-bottom: 15px;">
                    <i class="fas fa-check-circle" style="color: #27ae60; margin-right: 8px;"></i>
                    <span style="font-size: 13px;">Always update patient follow-up dates</span>
                </div>
                <div style="margin-bottom: 15px;">
                    <i class="fas fa-chart-line" style="color: #1a56db; margin-right: 8px;"></i>
                    <span style="font-size: 13px;">Monitor disease trends for early outbreak detection</span>
                </div>
                <div style="margin-bottom: 15px;">
                    <i class="fas fa-clock" style="color: #f39c12; margin-right: 8px;"></i>
                    <span style="font-size: 13px;">Review pending follow-ups daily</span>
                </div>
                <div>
                    <i class="fas fa-prescription" style="color: #1a56db; margin-right: 8px;"></i>
                    <span style="font-size: 13px;">Maintain accurate prescription records</span>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="footer">
    <p><i class="far fa-copyright"></i> 2026 MediCore Clinic Management System. All rights reserved.</p>
</div>

<script>
    function updateDateTime() {
        const now = new Date();
        const options = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' };
        const dateTimeElement = document.getElementById('dateTime');
        if (dateTimeElement) {
            dateTimeElement.innerHTML = now.toLocaleDateString('en-US', options);
        }
    }
    updateDateTime();
    setInterval(updateDateTime, 1000);
</script>