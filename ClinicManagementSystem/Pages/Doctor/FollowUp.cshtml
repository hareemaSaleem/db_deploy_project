@page
@model ClinicManagementSystem.Pages.Doctor.FollowUpModel
@{
    Layout = "_DoctorLayout";
    ViewData["Title"] = "Follow-Ups - MediCore";
}

<style>
    /* Keep ALL your existing CSS styles exactly as they are */
    .top-bar {
        background: white;
        border-radius: 12px;
        padding: 20px 25px;
        margin-bottom: 25px;
        box-shadow: 0 2px 5px rgba(0,0,0,0.05);
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .welcome-text h1 {
        font-size: 24px;
        color: #1a56db;
        margin-bottom: 5px;
    }

    .welcome-text p {
        color: #6c757d;
        font-size: 14px;
    }

    .doctor-name {
        font-size: 16px;
        font-weight: 600;
        color: #1a56db;
        text-align: right;
    }

    .doctor-specialty {
        font-size: 12px;
        color: #6c757d;
        text-align: right;
    }

    .date-time {
        background: #e8f0fe;
        padding: 8px 15px;
        border-radius: 8px;
        font-size: 13px;
        color: #1a56db;
        margin-top: 5px;
        text-align: center;
    }

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 20px;
        margin-bottom: 25px;
    }

    .stat-card {
        background: white;
        border-radius: 12px;
        padding: 20px;
        box-shadow: 0 2px 5px rgba(0,0,0,0.05);
        cursor: pointer;
        transition: transform 0.2s;
    }

        .stat-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 5px 15px rgba(0,0,0,0.1);
        }

    .stat-number {
        font-size: 28px;
        font-weight: bold;
        color: #1a56db;
        margin-bottom: 5px;
    }

    .stat-label {
        color: #6c757d;
        font-size: 13px;
    }

    .form-card {
        background: white;
        border-radius: 12px;
        box-shadow: 0 2px 5px rgba(0,0,0,0.05);
        overflow: hidden;
        margin-bottom: 25px;
    }

    .form-header {
        padding: 18px 20px;
        background: #1a56db;
        color: white;
    }

        .form-header h3 {
            font-size: 16px;
        }

    .form-body {
        padding: 25px;
    }

    .filter-row {
        display: flex;
        gap: 20px;
        margin-bottom: 25px;
        flex-wrap: wrap;
    }

    .filter-group {
        flex: 1;
    }

        .filter-group label {
            display: block;
            font-size: 12px;
            color: #6c757d;
            margin-bottom: 5px;
        }

        .filter-group input, .filter-group select {
            width: 100%;
            padding: 10px;
            border: 1px solid #ddd;
            border-radius: 8px;
            font-size: 14px;
        }

    .search-input {
        width: 100%;
        padding: 10px;
        border: 1px solid #ddd;
        border-radius: 8px;
        font-size: 14px;
    }

    .channel-cards {
        display: flex;
        gap: 20px;
        margin: 20px 0;
    }

    .channel-card {
        flex: 1;
        border: 2px solid #e8f0fe;
        border-radius: 12px;
        padding: 20px;
        cursor: pointer;
        transition: all 0.2s;
    }

        .channel-card.selected {
            border-color: #1a56db;
            background: #e8f0fe;
        }

        .channel-card:hover {
            border-color: #1a56db;
        }

    .channel-icon {
        font-size: 32px;
        color: #1a56db;
        margin-bottom: 10px;
    }

    .channel-title {
        font-weight: 600;
        color: #2d3748;
        margin-bottom: 5px;
    }

    .channel-desc {
        font-size: 12px;
        color: #6c757d;
    }

    .message-preview {
        background: #f8f9fa;
        border-radius: 12px;
        padding: 20px;
        margin: 20px 0;
        border: 1px solid #e8f0fe;
    }

        .message-preview h4 {
            font-size: 14px;
            color: #2d3748;
            margin-bottom: 15px;
        }

    .preview-content {
        font-size: 13px;
        line-height: 1.6;
        color: #2d3748;
    }

        .preview-content strong {
            color: #1a56db;
        }

    .send-options {
        display: flex;
        gap: 20px;
        margin: 20px 0;
    }

    .send-option {
        flex: 1;
        border: 1px solid #ddd;
        border-radius: 10px;
        padding: 15px;
        cursor: pointer;
    }

        .send-option.selected {
            border-color: #1a56db;
            background: #e8f0fe;
        }

    .send-option-title {
        font-weight: 600;
        color: #2d3748;
    }

    .recipients-table {
        width: 100%;
        border-collapse: collapse;
        margin: 15px 0;
    }

        .recipients-table th {
            text-align: left;
            padding: 12px;
            background: #f8f9fa;
            font-size: 12px;
            color: #6c757d;
            border-bottom: 1px solid #e8f0fe;
        }

        .recipients-table td {
            padding: 12px;
            border-bottom: 1px solid #e8f0fe;
            font-size: 13px;
        }

    .checkbox-col {
        width: 40px;
        text-align: center;
    }

        .checkbox-col input {
            width: 18px;
            height: 18px;
        }

    .method-badge {
        display: inline-block;
        padding: 4px 10px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 600;
    }

    .method-email {
        background: #e8f0fe;
        color: #1a56db;
    }

    .method-sms {
        background: #e8fce8;
        color: #27ae60;
    }

    .summary-bar {
        background: #e8f0fe;
        padding: 12px;
        border-radius: 8px;
        display: flex;
        justify-content: space-between;
        margin-top: 10px;
    }

    .additional-options {
        margin: 20px 0;
    }

    .checkbox-option {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 10px;
    }

        .checkbox-option input {
            width: 18px;
            height: 18px;
        }

    .action-buttons {
        display: flex;
        gap: 15px;
        margin-top: 25px;
    }

    .btn-send {
        flex: 1;
        padding: 14px;
        background: #1a56db;
        color: white;
        border: none;
        border-radius: 8px;
        font-size: 16px;
        font-weight: 600;
        cursor: pointer;
    }

        .btn-send:hover {
            background: #0e3fad;
        }

    .info-message {
        background: #e8f0fe;
        border-left: 4px solid #1a56db;
        padding: 12px 15px;
        margin-bottom: 20px;
        border-radius: 8px;
    }

    .no-data {
        text-align: center;
        padding: 40px;
        color: #6c757d;
    }
</style>

<div class="top-bar">
    <div class="welcome-text">
        <h1>Follow-Ups</h1>
        <p>Send follow-up reminders to patients</p>
    </div>
    <div>
        <div class="doctor-name">@Model.DoctorName</div>
        <div class="doctor-specialty">@Model.Specialization | @Model.ClinicName</div>
        <div class="date-time" id="dateTime"></div>
    </div>
</div>

<!-- ✅ UPDATED: Using Stats property -->
<div class="stats-grid">
    <div class="stat-card" onclick="filterByDate('today')">
        <div class="stat-number">@Model.Stats.SentToday</div>
        <div class="stat-label">Reminders Sent Today</div>
    </div>
    <div class="stat-card" onclick="filterByDate('tomorrow')">
        <div class="stat-number">@Model.Stats.ScheduledForTomorrow</div>
        <div class="stat-label">Scheduled for Tomorrow</div>
    </div>
    <div class="stat-card" onclick="filterByDate('upcoming')">
        <div class="stat-number">@Model.Stats.UpcomingNext7Days</div>
        <div class="stat-label">Upcoming (Next 7 Days)</div>
    </div>
    <div class="stat-card" onclick="filterByDate('all')">
        <div class="stat-number">@Model.Stats.TotalSentThisMonth</div>
        <div class="stat-label">Total Sent (This Month)</div>
    </div>
</div>

<div class="form-card">
    <div class="form-header">
        <h3><i class="fas fa-bell"></i> Send Follow-Up Reminder</h3>
    </div>
    <div class="form-body">
        <div class="filter-row">
            <div class="filter-group">
                <label>Follow-Up Date</label>
                <input type="date" id="followUpDate" onchange="loadPatients()" />
            </div>
        </div>

        <div class="filter-group" style="margin-bottom: 20px;">
            <label>Search Patient</label>
            <input type="text" id="patientSearch" class="search-input" placeholder="Search by patient name, email or phone..." onkeyup="loadPatients()" />
        </div>

        <h4 style="font-size: 14px; color: #2d3748; margin: 20px 0 10px;">Select Notification Channel</h4>
        <div class="channel-cards">
            <div class="channel-card selected" id="channelEmail" onclick="selectChannel('email')">
                <div class="channel-icon"><i class="fas fa-envelope"></i></div>
                <div class="channel-title">Send via Email</div>
                <div class="channel-desc">Send reminder to patient's email address</div>
            </div>
            <div class="channel-card" id="channelSms" onclick="selectChannel('sms')">
                <div class="channel-icon"><i class="fas fa-mobile-alt"></i></div>
                <div class="channel-title">Send via SMS</div>
                <div class="channel-desc">Send reminder to patient's phone number</div>
            </div>
        </div>

        <div class="message-preview">
            <h4><i class="fas fa-eye"></i> Message Preview</h4>
            <div class="preview-content" id="messagePreview">
                Loading...
            </div>
        </div>

        <h4 style="font-size: 14px; color: #2d3748; margin: 20px 0 10px;">When to Send</h4>
        <div class="send-options">
            <div class="send-option selected" id="sendNow" onclick="selectSendOption('now')">
                <div class="send-option-title"><i class="fas fa-paper-plane"></i> Send Now</div>
                <div class="channel-desc">Send reminders immediately</div>
            </div>
            <div class="send-option" id="sendLater" onclick="selectSendOption('later')">
                <div class="send-option-title"><i class="fas fa-calendar-alt"></i> Schedule for Later</div>
                <div class="channel-desc">Choose date and time to send reminders</div>
            </div>
        </div>
        <div id="schedulePicker" style="display: none; margin-top: 10px;">
            <input type="datetime-local" id="scheduleDateTime" class="search-input" style="width: auto;" />
        </div>

        <h4 style="font-size: 14px; color: #2d3748; margin: 20px 0 10px;">Recipients</h4>
        <div id="recipientsContainer">
            <div class="no-data">Select a date to view patients with follow-ups</div>
        </div>

        <div class="summary-bar" id="summaryBar" style="display: none;"></div>

        <div class="action-buttons">
            <button class="btn-send" onclick="sendReminders()">
                <i class="fas fa-paper-plane"></i> Send Reminders
            </button>
        </div>
    </div>
</div>

<script>
    let patients = [];
    let currentChannel = "email";
    let currentSendOption = "now";
    let selectedPatients = new Set();

    function setDefaultDate() {
        const today = new Date().toISOString().split('T')[0];
        const dateInput = document.getElementById('followUpDate');
        if (!dateInput.value) {
            dateInput.value = today;
        }
    }

    function loadPatients() {
        const followUpDate = document.getElementById('followUpDate').value;
        const searchTerm = document.getElementById('patientSearch').value;

        if (!followUpDate) return;

        fetch(`/Doctor/FollowUp?handler=Patients&date=${followUpDate}&searchTerm=${encodeURIComponent(searchTerm)}`)
            .then(response => response.json())
            .then(data => {
                patients = data;
                renderRecipientsTable();
                updateMessagePreview();
            })
            .catch(error => {
                console.error('Error loading patients:', error);
                document.getElementById('recipientsContainer').innerHTML = '<div class="no-data">Error loading patients</div>';
            });
    }

    function renderRecipientsTable() {
        const container = document.getElementById('recipientsContainer');

        if (patients.length === 0) {
            container.innerHTML = '<div class="no-data">No patients with follow-ups on this date</div>';
            document.getElementById('summaryBar').style.display = 'none';
            return;
        }

        let emailCount = 0;
        let smsCount = 0;
        let selectedCount = 0;

        let tableHtml = `
            <table class="recipients-table">
                <thead>
                    <tr>
                        <th class="checkbox-col"><input type="checkbox" id="selectAll" onchange="toggleSelectAll()" ${patients.every(p => p.reminderSentToday) ? 'disabled' : ''} /></th>
                        <th>Recipient</th>
                        <th>Contact</th>
                        <th>Method</th>
                        <th>Follow-Up Date</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
        `;

        patients.forEach(patient => {
            const hasEmail = patient.email && patient.email !== "";
            const hasPhone = patient.phone && patient.phone !== "";

            let method = "";
            let contact = "";

            if (currentChannel === "email" && hasEmail) {
                method = "Email";
                contact = patient.email;
                emailCount++;
            } else if (currentChannel === "sms" && hasPhone) {
                method = "SMS";
                contact = patient.phone;
                smsCount++;
            } else if (hasEmail) {
                method = "Email";
                contact = patient.email;
                emailCount++;
            } else if (hasPhone) {
                method = "SMS";
                contact = patient.phone;
                smsCount++;
            } else {
                method = "No Contact";
                contact = "No email or phone available";
            }

            const methodClass = method === "Email" ? "method-email" : (method === "SMS" ? "method-sms" : "");
            const isSelected = selectedPatients.has(patient.name) && !patient.reminderSentToday;
            const canSelect = !patient.reminderSentToday && method !== "No Contact";

            if (isSelected) selectedCount++;

            const followUpDate = new Date(patient.followUpDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });

            let statusHtml = '';
            if (patient.reminderSentToday) {
                statusHtml = `<span style="color: #27ae60; font-size: 11px;">
                    <i class="fas fa-check-circle"></i> Reminder sent today at ${patient.lastReminderTime} via ${patient.lastReminderChannel}
                </span>`;
            } else {
                statusHtml = `<span style="color: #f39c12; font-size: 11px;">
                    <i class="fas fa-clock"></i> Pending
                </span>`;
            }

            tableHtml += `
                <tr>
                    <td class="checkbox-col">
                        <input type="checkbox" class="patient-checkbox"
                               data-name="${patient.name.replace(/"/g, '&quot;')}"
                               data-patientid="${patient.patientId}"
                               data-email="${patient.email}"
                               data-phone="${patient.phone}"
                               data-followupdate="${patient.followUpDate}"
                               data-prescriptionid="${patient.prescriptionId}"
                               ${canSelect && isSelected ? 'checked' : ''}
                               ${!canSelect ? 'disabled' : ''}
                               onchange="togglePatientSelection(this)" />
                    </td>
                    <td>
                        <strong>${patient.name}</strong><br>
                        <span style="font-size: 11px; color: #6c757d;">${patient.diagnosis || ''}</span>
                    </br>
                    <td>${contact}</br>
                    <td><span class="method-badge ${methodClass}">${method}</span></br>
                    <td>${followUpDate}</br>
                    <td style="min-width: 140px;">${statusHtml}</br>
                </tr>
            `;
        });

        tableHtml += `
                </tbody>
            </table>
        `;

        container.innerHTML = tableHtml;

        const summaryBar = document.getElementById('summaryBar');
        summaryBar.style.display = 'flex';
        summaryBar.innerHTML = `
            <div>📧 Email: ${emailCount}</div>
            <div>📱 SMS: ${smsCount}</div>
            <div>✅ Selected: ${selectedCount} of ${patients.filter(p => !p.reminderSentToday).length} available</div>
        `;

        const selectAllCheckbox = document.getElementById('selectAll');
        if (selectAllCheckbox) {
            const availablePatients = patients.filter(p => !p.reminderSentToday);
            selectAllCheckbox.checked = selectedCount === availablePatients.length && availablePatients.length > 0;
        }
    }

    function toggleSelectAll() {
        const selectAll = document.getElementById('selectAll').checked;
        const checkboxes = document.querySelectorAll('.patient-checkbox:not(:disabled)');

        checkboxes.forEach(cb => {
            cb.checked = selectAll;
            const name = cb.getAttribute('data-name');
            if (selectAll) {
                selectedPatients.add(name);
            } else {
                selectedPatients.delete(name);
            }
        });

        renderRecipientsTable();
    }

    function togglePatientSelection(checkbox) {
        const name = checkbox.getAttribute('data-name');
        if (checkbox.checked) {
            selectedPatients.add(name);
        } else {
            selectedPatients.delete(name);
        }
        renderRecipientsTable();
    }

    function updateMessagePreview() {
        const selectedCount = selectedPatients.size;
        const doctorName = "@Model.DoctorName";
        const clinicName = "@Model.ClinicName";
        const followUpDate = document.getElementById('followUpDate').value;
        const formattedDate = followUpDate ? new Date(followUpDate).toLocaleDateString('en-US', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) : 'your follow-up date';

        let previewHtml = `
            <strong>📧 Subject: Reminder – Follow-Up Appointment</strong><br /><br />
            Dear <strong>{Patient Name}</strong>,<br /><br />
            This is a friendly reminder about your follow-up appointment.<br /><br />
            📅 <strong>Date:</strong> ${formattedDate}<br />
            📍 <strong>Location:</strong> ${clinicName}<br /><br />
            Please arrive 10 minutes before your scheduled time.<br />
            If you need to reschedule, please contact us.<br /><br />
            Thank you!<br />
            — ${doctorName}
        `;

        if (selectedCount > 0) {
            previewHtml += `<br /><br /><span style="color: #27ae60;">✅ Sending to ${selectedCount} patient(s)</span>`;
        }

        document.getElementById('messagePreview').innerHTML = previewHtml;
    }

    function selectChannel(channel) {
        currentChannel = channel;
        document.getElementById('channelEmail').classList.remove('selected');
        document.getElementById('channelSms').classList.remove('selected');
        document.getElementById(`channel${channel === 'email' ? 'Email' : 'Sms'}`).classList.add('selected');
        renderRecipientsTable();
    }

    function selectSendOption(option) {
        currentSendOption = option;
        document.getElementById('sendNow').classList.remove('selected');
        document.getElementById('sendLater').classList.remove('selected');
        document.getElementById(`send${option === 'now' ? 'Now' : 'Later'}`).classList.add('selected');
        document.getElementById('schedulePicker').style.display = option === 'later' ? 'block' : 'none';
    }

    function filterByDate(status) {
        const today = new Date();
        let targetDate = new Date();

        if (status === 'tomorrow') {
            targetDate.setDate(today.getDate() + 1);
        } else if (status === 'upcoming') {
            targetDate.setDate(today.getDate() + 7);
        } else {
            targetDate = today;
        }

        document.getElementById('followUpDate').value = targetDate.toISOString().split('T')[0];
        loadPatients();
    }

    function sendReminders() {
        const selectedCheckboxes = document.querySelectorAll('.patient-checkbox:checked');

        if (selectedCheckboxes.length === 0) {
            alert('⚠️ Please select at least one patient to send reminders');
            return;
        }

        const selectedPatientsData = [];
        selectedCheckboxes.forEach(cb => {
            selectedPatientsData.push({
                name: cb.getAttribute('data-name'),
                patientId: parseInt(cb.getAttribute('data-patientid')),
                email: cb.getAttribute('data-email'),
                phone: cb.getAttribute('data-phone'),
                followUpDate: cb.getAttribute('data-followupdate'),
                prescriptionId: parseInt(cb.getAttribute('data-prescriptionid'))
            });
        });

        const requestData = {
            patients: selectedPatientsData,
            channel: currentChannel,
            sendNow: currentSendOption === 'now',
            scheduledDateTime: currentSendOption === 'later' ? document.getElementById('scheduleDateTime').value : null
        };

        const sendBtn = document.querySelector('.btn-send');
        const originalText = sendBtn.innerHTML;
        sendBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Sending...';
        sendBtn.disabled = true;

        fetch('/Doctor/FollowUp?handler=SaveReminders', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify(requestData)
        })
        .then(response => response.json())
        .then(result => {
            if (result.success) {
                let message = `✅ ${result.count} reminder(s) sent successfully!`;
                if (result.skipped > 0) {
                    message += `\n⚠️ ${result.skipped} skipped (reminder already sent today)`;
                }
                alert(message);
                selectedPatients.clear();
                loadPatients();
                location.reload();
            } else {
                alert(`❌ Failed to send reminders: ${result.message}`);
            }
        })
        .catch(error => {
            console.error('Error sending reminders:', error);
            alert('❌ Error sending reminders. Please try again.');
        })
        .finally(() => {
            sendBtn.innerHTML = originalText;
            sendBtn.disabled = false;
        });
    }

    function updateDateTime() {
        const now = new Date();
        const options = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' };
        const dateTimeElement = document.getElementById('dateTime');
        if (dateTimeElement) {
            dateTimeElement.innerHTML = now.toLocaleDateString('en-US', options);
        }
    }

    setDefaultDate();
    loadPatients();
    updateDateTime();
    setInterval(updateDateTime, 1000);
</script>