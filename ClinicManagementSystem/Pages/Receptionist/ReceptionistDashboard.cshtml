@page
@model ClinicManagementSystem.Pages.Receptionist.ReceptionistDashboardModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Receptionist Dashboard - MediCore";
}

<style>
    .top-bar {
        background: white;
        border-radius: 12px;
        padding: 20px 25px;
        margin-bottom: 25px;
        box-shadow: 0 2px 5px rgba(0,0,0,0.05);
    }

    .welcome-text h1 {
        font-size: 24px;
        color: #1a56db;
        margin-bottom: 5px;
    }

    .welcome-text p {
        color: #6c757d;
        font-size: 14px;
    }

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 20px;
        margin-bottom: 30px;
    }

    .stat-card {
        background: white;
        border-radius: 12px;
        padding: 20px;
        box-shadow: 0 2px 5px rgba(0,0,0,0.05);
        display: flex;
        justify-content: space-between;
        align-items: center;
        cursor: pointer;
        transition: transform 0.2s;
    }

        .stat-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 5px 15px rgba(0,0,0,0.1);
        }

    .stat-info h3 {
        font-size: 28px;
        color: #1a56db;
        margin-bottom: 5px;
    }

    .stat-info p {
        color: #6c757d;
        font-size: 13px;
    }

    .stat-icon i {
        font-size: 32px;
        color: #1a56db;
        opacity: 0.5;
    }

    .two-columns {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 25px;
        margin-bottom: 30px;
    }

    .card {
        background: white;
        border-radius: 12px;
        box-shadow: 0 2px 5px rgba(0,0,0,0.05);
        overflow: hidden;
    }

    .card-header {
        padding: 18px 20px;
        border-bottom: 1px solid #e8f0fe;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

        .card-header h3 {
            font-size: 16px;
            color: #2d3748;
        }

        .card-header a {
            color: #1a56db;
            text-decoration: none;
            font-size: 13px;
        }

    .appointments-table {
        width: 100%;
        border-collapse: collapse;
    }

        .appointments-table th {
            text-align: left;
            padding: 12px 15px;
            background: #f8f9fa;
            font-size: 12px;
            color: #6c757d;
            font-weight: 600;
        }

        .appointments-table td {
            padding: 12px 15px;
            border-bottom: 1px solid #e8f0fe;
            font-size: 13px;
        }

    .patient-name {
        font-weight: 600;
        color: #2d3748;
    }

    .patient-detail {
        font-size: 11px;
        color: #6c757d;
    }

    .status-badge {
        display: inline-block;
        padding: 4px 10px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 600;
    }

    .status-inprogress {
        background: #fff3e0;
        color: #f39c12;
    }

    .status-waiting {
        background: #e8f0fe;
        color: #1a56db;
    }

    .status-scheduled {
        background: #e8fce8;
        color: #27ae60;
    }

    .queue-list {
        padding: 10px 0;
    }

    .queue-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 12px 20px;
        border-bottom: 1px solid #e8f0fe;
    }

    .queue-info .patient-name {
        font-weight: 600;
        margin-bottom: 4px;
    }

    .queue-info .patient-detail {
        font-size: 11px;
    }

    .queue-priority {
        text-align: right;
    }

    .priority-emergency {
        color: #e53e3e;
        font-size: 11px;
        font-weight: 600;
    }

    .priority-normal {
        color: #1a56db;
        font-size: 11px;
        font-weight: 600;
    }

    .priority-routine {
        color: #6c757d;
        font-size: 11px;
        font-weight: 600;
    }

    .queue-time {
        font-size: 11px;
        color: #6c757d;
        margin-top: 4px;
    }

    .view-link {
        text-align: center;
        padding: 12px;
        border-top: 1px solid #e8f0fe;
    }

        .view-link a {
            color: #1a56db;
            text-decoration: none;
            font-size: 13px;
        }

    .quick-actions {
        background: white;
        border-radius: 12px;
        padding: 20px;
        box-shadow: 0 2px 5px rgba(0,0,0,0.05);
    }

        .quick-actions h3 {
            font-size: 16px;
            margin-bottom: 15px;
            color: #2d3748;
        }

    .actions-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 12px;
    }

    .action-btn {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 12px;
        background: #f8f9fa;
        border-radius: 8px;
        text-decoration: none;
        color: #2d3748;
        font-size: 13px;
        transition: all 0.2s;
    }

        .action-btn:hover {
            background: #1a56db;
            color: white;
        }

        .action-btn i {
            width: 18px;
            font-size: 14px;
        }

    .action-desc {
        font-size: 10px;
        color: #6c757d;
        margin-top: 3px;
    }

    .action-btn:hover .action-desc {
        color: rgba(255,255,255,0.8);
    }

    @@media (max-width: 1200px) {
        .stats-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .two-columns {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="top-bar">
    <div class="welcome-text">
        <h1>Welcome back, Ayesha!</h1>
        <p>Here's what's happening in the clinic today.</p>
    </div>
</div>
<div class="stats-grid">
    <div class="stat-card" onclick="window.location.href='/Receptionist/Appointments'">
        <div class="stat-info">
            <h3>@Model.TodayAppointmentsCount</h3>
            <p>Today's Appointments</p>
        </div>
        <div class="stat-icon">
            <i class="fas fa-calendar-day"></i>
        </div>
    </div>
    <div class="stat-card" onclick="window.location.href='/Receptionist/RegisterPatient'">
        <div class="stat-info">
            <h3>@Model.NewPatientsCount</h3>
            <p>New Patients</p>
        </div>
        <div class="stat-icon">
            <i class="fas fa-user-plus"></i>
        </div>
    </div>
    <div class="stat-card" onclick="window.location.href='/Receptionist/GenerateBill'">
        <div class="stat-info">
            <h3>@Model.TodayBillingsTotal.ToString("N0")</h3>
            <p>Today's Billings</p>
        </div>
        <div class="stat-icon">
            <i class="fas fa-file-invoice"></i>
        </div>
    </div>
    <div class="stat-card" onclick="window.location.href='/Receptionist/GenerateBill'">
        <div class="stat-info">
            <h3>PKR @Model.PendingPaymentsTotal.ToString("N0")</h3>
            <p>Pending Payments</p>
        </div>
        <div class="stat-icon">
            <i class="fas fa-clock"></i>
        </div>
    </div>
</div>
<div class="two-columns">
    <div class="card">
        <div class="card-header">
            <h3>Today's Appointments</h3>
            <a href="/Receptionist/Appointments">View all appointments →</a>
        </div>
        <table class="appointments-table">
            <thead>
                <tr>
                    <th>Time</th>
                    <th>Patient Name</th>
                    <th>Doctor</th>
                    <th>Type</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.TodayAppointments != null && Model.TodayAppointments.Any())
                {
                    foreach (var apt in Model.TodayAppointments)
                    {
                        var priorityStyle = apt.PriorityLevel == "Emergency" ? "background:#fff3e0;color:#f39c12;" :
                   (apt.PriorityLevel == "Normal" ? "background:#e8f0fe;color:#1a56db;" :
                   "background:#e8fce8;color:#27ae60;");

                        var statusClass = apt.Status == "In Progress" ? "status-inprogress" :
                                         (apt.Status == "Waiting" ? "status-waiting" : "status-scheduled");

                        <tr>
                            <td>@(new DateTime(1, 1, 1, apt.AppointmentTime.Hours, apt.AppointmentTime.Minutes, 0).ToString("h:mm tt"))</td>
                            <td>
                                <div class="patient-name">@(apt.Patient?.Name ?? "N/A")</div>
                                <div class="patient-detail">@(apt.Patient?.Age ?? 0) / @(apt.Patient?.Gender ?? "N/A")</div>
                            </td>
                            <td>
                                @(apt.Doctor?.Name ?? "Unknown")<br>
                                <span class="patient-detail">@(apt.Doctor?.Specialization ?? "")</span>
                            </td>
                            <td><span class="status-badge" style="@priorityStyle">@apt.PriorityLevel</span></td>
                            <td><span class="status-badge @statusClass">@apt.Status</span></td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" style="text-align:center; padding:30px;">No appointments today</td>
                    </tr>
                }
            </tbody>
        </table>
        <div class="view-link">
            <a href="/Receptionist/Appointments">View All Appointments →</a>
        </div>
    </div>
    <div class="card">
        <div class="card-header">
            <h3>Waiting Queue</h3>
            <a href="/Receptionist/Appointments">View Full Queue →</a>
        </div>
        <div class="queue-list">
            @if (Model.WaitingQueue != null && Model.WaitingQueue.Any())
            {
                foreach (var apt in Model.WaitingQueue)
                {
                    string priorityClass = apt.PriorityLevel == "Emergency" ? "priority-emergency" :
                                          (apt.PriorityLevel == "Normal" ? "priority-normal" : "priority-routine");
                    
                    <div class="queue-item">
                        <div class="queue-info">
                            <div class="patient-name">@(apt.Patient?.Name ?? "N/A")</div>
                            <div class="patient-detail">@(apt.Patient?.Age ?? 0) / @(apt.Patient?.Gender ?? "N/A")</div>
                        </div>
                        <div class="queue-priority">
                            <div class="@priorityClass">@apt.PriorityLevel</div>
                            <div class="queue-time">@(new DateTime(1, 1, 1, apt.AppointmentTime.Hours, apt.AppointmentTime.Minutes, 0).ToString("h:mm tt"))</div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div style="text-align:center; padding:30px; color:#6c757d;">No patients in waiting queue</div>
            }
        </div>
        <div class="view-link">
            <a href="/Receptionist/Appointments">View Full Queue →</a>
        </div>
    </div>
</div>

<div class="quick-actions">
    <h3>Quick Actions</h3>
    <div class="actions-grid">
        <a href="/Receptionist/RegisterPatient" class="action-btn">
            <i class="fas fa-user-plus"></i>
            <div><div>Register Patient</div><div class="action-desc">Add new patient</div></div>
        </a>
        <a href="/Receptionist/Appointments" class="action-btn">
            <i class="fas fa-calendar-plus"></i>
            <div><div>Book Appointment</div><div class="action-desc">Schedule new appointment</div></div>
        </a>
        <a href="/Receptionist/GenerateBill" class="action-btn">
            <i class="fas fa-file-invoice"></i>
            <div><div>Generate Bill</div><div class="action-desc">Create patient bill</div></div>
        </a>
        <a href="/Receptionist/MedicineStock" class="action-btn">
            <i class="fas fa-pills"></i>
            <div><div>Medicine Stock</div><div class="action-desc">Manage medicines</div></div>
        </a>
        <a href="/Receptionist/PatientList" class="action-btn">
            <i class="fas fa-users"></i>
            <div><div>Patients List</div><div class="action-desc">View all patients</div></div>
        </a>
        <a href="/Receptionist/MedicalRep" class="action-btn">
            <i class="fas fa-user-md"></i>
            <div><div>Medical Reps</div><div class="action-desc">View rep visits</div></div>
        </a>
    </div>
</div>