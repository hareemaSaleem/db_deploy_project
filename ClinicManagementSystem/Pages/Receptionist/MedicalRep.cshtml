@page
@model ClinicManagementSystem.Pages.Receptionist.MedicalRepModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Medical Rep Visit - MediCore";
}

<style>
    .top-bar {
        background: white;
        border-radius: 12px;
        padding: 20px 25px;
        margin-bottom: 25px;
        box-shadow: 0 2px 5px rgba(0,0,0,0.05);
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .welcome-text h1 {
        font-size: 24px;
        color: #1a56db;
        margin-bottom: 5px;
    }

    .welcome-text p {
        color: #6c757d;
        font-size: 14px;
    }

    .date-time {
        background: #e8f0fe;
        padding: 8px 15px;
        border-radius: 8px;
        font-size: 13px;
        color: #1a56db;
    }

    .form-card {
        background: white;
        border-radius: 12px;
        box-shadow: 0 2px 5px rgba(0,0,0,0.05);
        overflow: hidden;
        margin-bottom: 25px;
    }

    .form-header {
        padding: 18px 20px;
        background: #1a56db;
        color: white;
    }

        .form-header h3 {
            font-size: 16px;
        }

    .form-body {
        padding: 25px;
    }

    .section-title {
        font-size: 15px;
        color: #1a56db;
        margin-bottom: 20px;
        padding-bottom: 8px;
        border-bottom: 2px solid #1a56db;
    }

    .form-row {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
        margin-bottom: 25px;
    }

    .form-group {
        margin-bottom: 15px;
    }

    label {
        display: block;
        margin-bottom: 8px;
        font-weight: 600;
        color: #2d3748;
        font-size: 13px;
    }

    .required {
        color: #e53e3e;
    }

    input, select, textarea {
        width: 100%;
        padding: 10px 12px;
        border: 1px solid #ddd;
        border-radius: 8px;
        font-size: 14px;
        transition: all 0.3s;
    }

        input:focus, select:focus, textarea:focus {
            outline: none;
            border-color: #1a56db;
            box-shadow: 0 0 0 2px rgba(26,86,219,0.1);
        }

    .samples-table {
        width: 100%;
        border-collapse: collapse;
        margin-bottom: 15px;
    }

        .samples-table th {
            text-align: left;
            padding: 12px 10px;
            background: #f8f9fa;
            font-size: 12px;
            color: #6c757d;
            font-weight: 600;
            border-bottom: 1px solid #e8f0fe;
        }

        .samples-table td {
            padding: 10px;
            border-bottom: 1px solid #e8f0fe;
        }

        .samples-table input, .samples-table select {
            padding: 8px 10px;
            font-size: 13px;
        }

    .remove-btn {
        background: none;
        border: none;
        color: #e53e3e;
        cursor: pointer;
        font-size: 16px;
    }

    .add-btn {
        background: none;
        border: 1px solid #1a56db;
        color: #1a56db;
        padding: 8px 20px;
        border-radius: 8px;
        cursor: pointer;
        font-size: 13px;
        margin-top: 10px;
    }

        .add-btn:hover {
            background: #1a56db;
            color: white;
        }

    .remarks-group {
        margin: 20px 0;
    }

    textarea {
        resize: vertical;
        min-height: 80px;
    }

    .action-buttons {
        display: flex;
        gap: 15px;
        margin-top: 25px;
    }

    .btn-save {
        flex: 1;
        padding: 12px;
        background: #1a56db;
        color: white;
        border: none;
        border-radius: 8px;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
    }

        .btn-save:hover {
            background: #0e3fad;
        }

    .btn-cancel {
        flex: 1;
        padding: 12px;
        background: #e8f0fe;
        color: #2d3748;
        border: none;
        border-radius: 8px;
        font-size: 14px;
        cursor: pointer;
    }

        .btn-cancel:hover {
            background: #ddd;
        }

    .mandatory-note {
        font-size: 11px;
        color: #6c757d;
        margin-top: 15px;
        text-align: center;
    }

    .success-message {
        background: #c6f6d5;
        color: #276749;
        padding: 12px;
        border-radius: 8px;
        margin-bottom: 20px;
    }

    .error-message {
        background: #fed7d7;
        color: #c53030;
        padding: 12px;
        border-radius: 8px;
        margin-bottom: 20px;
    }
</style>

<div class="top-bar">
    <div class="welcome-text">
        <h1>Med Rep Visit Form</h1>
        <p>Record details of doctor visit and samples given</p>
    </div>
    <div class="date-time" id="dateTime"></div>
</div>

@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <div class="success-message">✅ @Model.SuccessMessage</div>
}
@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="error-message">❌ @Model.ErrorMessage</div>
}

<div class="form-card">
    <div class="form-header">
        <h3><i class="fas fa-clipboard-list"></i> Visit Information</h3>
    </div>
    <div class="form-body">
        <form method="post">
            <div class="section-title">1. Representative Details</div>
            <div class="form-row">
                <div class="form-group">
                    <label>Rep Name <span class="required">*</span></label>
                    <input type="text" asp-for="NewMedicalRep.RepName" placeholder="Enter representative name" required />
                </div>
                <div class="form-group">
                    <label>Company Name <span class="required">*</span></label>
                    <input type="text" asp-for="NewMedicalRep.CompanyName" placeholder="Enter company name" required />
                </div>
                <div class="form-group">
                    <label>Date of Visit <span class="required">*</span></label>
                    <input type="date" asp-for="NewMedicalRep.VisitDate" required />
                </div>
            </div>

            <div class="section-title">2. Medicine Sample Details</div>
            <table class="samples-table" id="samplesTable">
                <thead>
                    <tr>
                        <th style="width: 35%;">Medicine Name <span class="required">*</span></th>
                        <th style="width: 20%;">Quantity <span class="required">*</span></th>
                        <th style="width: 30%;">Expiry Date</th>
                        <th style="width: 15%;">Actions</th>
                    </tr>
                </thead>
                <tbody id="samplesBody">
                    <tr id="sampleRow1">
                        <td><input type="text" name="medName" class="medName" placeholder="Enter medicine name" /></td>
                        <td><input type="number" name="medQty" class="medQty" placeholder="0" min="0" value="0" /></td>
                        <td><input type="date" name="medExpiry" class="medExpiry" /></td>
                        <td><button type="button" class="remove-btn" onclick="removeSample(this)"><i class="fas fa-trash"></i></button></td>
                    </tr>
                    <tr id="sampleRow2">
                        <td><input type="text" name="medName" class="medName" placeholder="Enter medicine name" /></td>
                        <td><input type="number" name="medQty" class="medQty" placeholder="0" min="0" value="0" /></td>
                        <td><input type="date" name="medExpiry" class="medExpiry" /></td>
                        <td><button type="button" class="remove-btn" onclick="removeSample(this)"><i class="fas fa-trash"></i></button></td>
                    </tr>
                </tbody>
            </table>
            <button type="button" class="add-btn" onclick="addSampleRow()">
                <i class="fas fa-plus"></i> Add Another Sample
            </button>

            <div class="section-title" style="margin-top: 25px;">3. Remarks</div>
            <div class="remarks-group">
                <textarea asp-for="NewMedicalRep.Remarks" placeholder="Enter remarks or notes here..."></textarea>
            </div>

            <div class="section-title">4. Actions</div>
            <div class="action-buttons">
                <button type="submit" class="btn-save">
                    <i class="fas fa-save"></i> Save Visit
                </button>
                <button type="button" class="btn-cancel" onclick="cancelForm()">
                    <i class="fas fa-times"></i> Cancel
                </button>
            </div>

            <div class="mandatory-note">
                <i class="fas fa-asterisk" style="font-size: 10px; color: #e53e3e;"></i> All fields marked with * are mandatory.
            </div>
        </form>
    </div>
</div>

<script>
    let sampleCounter = 2;

    function addSampleRow() {
        sampleCounter++;
        const tbody = document.getElementById('samplesBody');
        const newRow = tbody.insertRow();
        newRow.id = `sampleRow${sampleCounter}`;
        newRow.innerHTML = `
            <td><input type="text" name="medName" class="medName" placeholder="Enter medicine name" /></td>
            <td><input type="number" name="medQty" class="medQty" placeholder="0" min="0" value="0" /></td>
            <td><input type="date" name="medExpiry" class="medExpiry" /></td>
            <td><button type="button" class="remove-btn" onclick="removeSample(this)"><i class="fas fa-trash"></i></button></td>
        `;
    }

    function removeSample(button) {
        const row = button.closest('tr');
        if (document.getElementById('samplesBody').children.length > 1) {
            row.remove();
        } else {
            alert("At least one sample row is required");
        }
    }

    function cancelForm() {
        document.querySelector('input[name="NewMedicalRep.RepName"]').value = '';
        document.querySelector('input[name="NewMedicalRep.CompanyName"]').value = '';
        document.querySelector('input[name="NewMedicalRep.VisitDate"]').value = '';
        document.querySelector('textarea[name="NewMedicalRep.Remarks"]').value = '';

        const tbody = document.getElementById('samplesBody');
        while (tbody.children.length > 1) {
            tbody.removeChild(tbody.lastChild);
        }

        const firstRow = tbody.children[0];
        firstRow.querySelector('.medName').value = '';
        firstRow.querySelector('.medQty').value = '0';
        firstRow.querySelector('.medExpiry').value = '';

        sampleCounter = 2;
    }

    function setDefaultDate() {
        const today = new Date().toISOString().split('T')[0];
        const visitDateInput = document.querySelector('input[name="NewMedicalRep.VisitDate"]');
        if (visitDateInput && !visitDateInput.value) {
            visitDateInput.value = today;
        }
    }

    function updateDateTime() {
        const now = new Date();
        const options = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' };
        document.getElementById('dateTime').innerHTML = now.toLocaleDateString('en-US', options);
    }

    updateDateTime();
    setInterval(updateDateTime, 1000);
    setDefaultDate();
</script>