<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MediCore</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }
            body {
                font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
                background: #e8f0fe;
                min-height: 100vh;
            }
            .dashboard-container {
                display: flex;
                min-height: 100vh;
            }
            .sidebar {
                width: 280px;
                background: #1a56db;
                color: white;
                position: fixed;
                height: 100vh;
                overflow-y: auto;
                box-shadow: 2px 0 10px rgba(0,0,0,0.1);
            }
            .sidebar-header {
                padding: 25px 20px;
                border-bottom: 1px solid rgba(255,255,255,0.2);
            }
            .sidebar-header h2 {
                font-size: 24px;
                margin-bottom: 5px;
            }

            .sidebar-header h2 span {
                font-weight: 300;
            }

            .sidebar-header p {
                font-size: 12px;
                opacity: 0.8;
            }

            .sidebar-menu {
                padding: 20px 0;
            }

            .menu-section {
                margin-bottom: 25px;
            }

            .menu-title {
                padding: 10px 20px;
                font-size: 12px;
                text-transform: uppercase;
                letter-spacing: 1px;
                opacity: 0.7;
            }

            .menu-item {
                padding: 12px 20px;
                display: flex;
                align-items: center;
                gap: 12px;
                cursor: pointer;
                transition: all 0.3s;
                color: white;
                text-decoration: none;
            }
            .menu-item:hover {
                background: rgba(255,255,255,0.1);
            }
            .menu-item i {
                width: 20px;
                font-size: 16px;
            }
            .menu-item.active {
                background: rgba(255,255,255,0.2);
                border-left: 3px solid white;
            }
            .main-content {
                flex: 1;
                margin-left: 280px;
                padding: 20px 30px;
                min-height: 100vh;
            }
            .top-bar {
                background: white;
                border-radius: 12px;
                padding: 20px 25px;
                margin-bottom: 25px;
                box-shadow: 0 2px 5px rgba(0,0,0,0.05);
                display: flex;
                justify-content: space-between;
                align-items: center;
            }
            .welcome-text h1 {
                font-size: 24px;
                color: #1a56db;
                margin-bottom: 5px;
            }
            .welcome-text p {
                color: #6c757d;
                font-size: 14px;
            }
            .date-time {
                background: #e8f0fe;
                padding: 8px 15px;
                border-radius: 8px;
                font-size: 13px;
                color: #1a56db;
            }
            .logout-btn {
                position: absolute;
                bottom: 20px;
                left: 0;
                right: 0;
                margin: 0 20px;
                padding: 12px;
                background: rgba(255,255,255,0.1);
                border-radius: 8px;
                text-align: center;
                text-decoration: none;
                color: white;
                display: flex;
                align-items: center;
                justify-content: center;
                gap: 10px;
            }
            .logout-btn:hover {
                background: #e53e3e;
            }
            media (max-width: 768px) {
                .sidebar {
                    transform: translateX(-100%);
                    position: fixed;
                    z-index: 1000;
                }
                .main-content {
                    margin-left: 0;
                }
            }
    </style>
</head>
<body>
    <div class="dashboard-container">
        <!-- Sidebar -->
        <div class="sidebar">
            <div class="sidebar-header">
                <h2>Medi<span style="font-weight:300;">Core</span></h2>
                <p>Smart Clinic Management</p>
            </div>
            <div class="sidebar-menu">
                <div class="menu-section">
                    <div class="menu-title">MAIN</div>
                    <a href="/Receptionist/ReceptionistDashboard" class="menu-item">
                        <i class="fas fa-tachometer-alt"></i>
                        <span>Dashboard</span>
                    </a>
                </div>
                <div class="menu-section">
                    <div class="menu-title">PATIENT MANAGEMENT</div>
                    <a href="/Receptionist/RegisterPatient" class="menu-item">
                        <i class="fas fa-user-plus"></i>
                        <span>Register Patient</span>
                    </a>
                    <a href="/Receptionist/PatientList" class="menu-item">
                        <i class="fas fa-users"></i>
                        <span>Patients List</span>
                    </a>
                    <a href="/Receptionist/Appointments" class="menu-item">
                        <i class="fas fa-calendar-check"></i>
                        <span>Appointments</span>
                    </a>
                    <a href="/Receptionist/GenerateBill" class="menu-item">
                        <i class="fas fa-file-invoice-dollar"></i>
                        <span>Billing</span>
                    </a>
                </div>
                <div class="menu-section">
                    <div class="menu-title">INVENTORY & OTHERS</div>
                    <a href="/Receptionist/MedicineStock" class="menu-item">
                        <i class="fas fa-pills"></i>
                        <span>Medicine Stock</span>
                    </a>
                    <a href="/Receptionist/MedicalRep" class="menu-item">
                        <i class="fas fa-user-md"></i>
                        <span>Medical Reps</span>
                    </a>
                </div>
            </div>
            <a href="/Shared/Login" class="logout-btn">
                <i class="fas fa-sign-out-alt"></i>
                <span>Logout</span>
            </a>
        </div>

        <!-- Main Content -->
        <div class="main-content">
            @RenderBody()
        </div>
    </div>
    <script>
            function updateDateTime() {
                const now = new Date();
                const options = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' };
                const dateTimeElement = document.getElementById('dateTime');
                if (dateTimeElement) {
                    dateTimeElement.innerHTML = now.toLocaleDateString('en-US', options);
                }
            }
            updateDateTime();
            setInterval(updateDateTime, 1000);
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>