@page
@model ClinicManagementSystem.Pages.Shared.LoginModel
@{
    Layout = null;
    ViewData["Title"] = "Login - MediCore";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    
    <style>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }
            body {
                font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
                background: #e8f0fe;
                min-height: 100vh;
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 20px;
            }
            .login-container {
                max-width: 480px;
                width: 100%;
                margin: 0 auto;
            }
            .login-card {
                background: white;
                border-radius: 12px;
                box-shadow: 0 5px 20px rgba(0, 0, 0, 0.08);
                overflow: hidden;
            }
            .login-header {
                background: white;
                padding: 35px 30px 20px;
                text-align: center;
                border-bottom: 1px solid #e8f0fe;
            }
                .login-header h1 {
                    font-size: 34px;
                    margin-bottom: 8px;
                    letter-spacing: -0.5px;
                    color: #1a56db;
                }
                   .login-header h1 span {
                        color: #1a56db;
                        font-weight: 300;
                    }
                .login-header p {
                    font-size: 14px;
                    color: #6c757d;
                    margin-bottom: 12px;
                }
            .clinic-badge {
                font-size: 13px;
                color: #6c757d;
                background: #f8f9fa;
                padding: 8px 16px;
                border-radius: 20px;
                display: inline-block;
            }
            .login-body {
                padding: 30px 35px 35px;
            }
            .welcome-text {
                text-align: center;
                margin-bottom: 28px;
            }
                .welcome-text h2 {
                    font-size: 24px;
                    color: #1a56db;
                    margin-bottom: 5px;
                }
                .welcome-text p {
                    font-size: 14px;
                    color: #6c757d;
                }
            .form-group {
                margin-bottom: 22px;
            }
            label {
                display: block;
                margin-bottom: 8px;
                font-weight: 600;
                color: #2d3748;
                font-size: 14px;
            }
                label i {
                    margin-right: 8px;
                    color: #1a56db;
                    width: 18px;
                }
            input, select {
                width: 100%;
                padding: 12px 15px;
                border: 1px solid #ddd;
                border-radius: 8px;
                font-size: 14px;
                transition: all 0.3s;
                font-family: inherit;
            }
                input:focus, select:focus {
                    outline: none;
                    border-color: #1a56db;
                    box-shadow: 0 0 0 2px rgba(26, 86, 219, 0.1);
                }
            .remember-row {
                display: flex;
                align-items: center;
                justify-content: space-between;
                margin-bottom: 25px;
            }
            .checkbox-label {
                display: flex;
                align-items: center;
                gap: 8px;
                cursor: pointer;
            }
                .checkbox-label input {
                    width: auto;
                    margin: 0;
                }
                .checkbox-label i {
                    color: #1a56db;
                    font-size: 14px;
                }
                .checkbox-label span {
                    font-size: 13px;
                    color: #4a5568;
                }
            .forgot-link {
                font-size: 13px;
                color: #1a56db;
                text-decoration: none;
            }
                .forgot-link i {
                    margin-right: 5px;
                    font-size: 12px;
                }
                .forgot-link:hover {
                    text-decoration: underline;
                }
            .btn-login {
                width: 100%;
                padding: 12px;
                background: #1a56db;
                color: white;
                border: none;
                border-radius: 8px;
                font-size: 15px;
                font-weight: 600;
                cursor: pointer;
                transition: background 0.2s;
            }
                .btn-login i {
                    margin-right: 8px;
                }
                .btn-login:hover {
                    background: #0e3fad;
                }
            .divider {
                text-align: center;
                margin: 25px 0;
                position: relative;
            }
                .divider::before {
                    content: "";
                    position: absolute;
                    top: 50%;
                    left: 0;
                    right: 0;
                    height: 1px;
                    background: #e8f0fe;
                }
                .divider span {
                    background: white;
                    padding: 0 15px;
                    position: relative;
                    color: #6c757d;
                    font-size: 13px;
                }
            .contact-admin {
                text-align: center;
                margin-top: 20px;
            }
                .contact-admin p {
                    font-size: 13px;
                    color: #6c757d;
                }
                .contact-admin a {
                    color: #1a56db;
                    text-decoration: none;
                    font-weight: 500;
                }
                    .contact-admin a i {
                        margin-right: 5px;
                    }
                    .contact-admin a:hover {
                        text-decoration: underline;
                    }
            .login-footer {
                background: #f8f9fa;
                padding: 15px 30px;
                text-align: center;
                border-top: 1px solid #e8f0fe;
            }
                .login-footer p {
                    font-size: 11px;
                    color: #a0aec0;
                }
            .error-message {
                background: #fef2f2;
                border: 1px solid #fecaca;
                color: #dc2626;
                padding: 10px;
                border-radius: 8px;
                margin-bottom: 20px;
                font-size: 13px;
            }
                .error-message i {
                    margin-right: 8px;
                }
    </style>
</head>
<body>
    <div class="login-container">
        <div class="login-card">
            <div class="login-header">
                <h1>Medi<span>Core</span></h1>
                <p>Smart Clinic Management System</p>
                <div class="clinic-badge">
                    <i class="fas fa-hospital-user"></i> A smart solution for modern clinics
                </div>
            </div>

            <div class="login-body">
                <div class="welcome-text">
                    <h2><i class="fas fa-hand-wave"></i> Welcome Back!</h2>
                    <p>Please login to access your account</p>
                </div>

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="error-message">
                        <i class="fas fa-exclamation-circle"></i> @TempData["ErrorMessage"]
                    </div>
                }

                <form method="post">
                    <div class="form-group">
                        <label><i class="fas fa-users"></i> User Role</label>
                        <select name="Role" required>
                            <option value="">Select Role</option>
                            <option value="receptionist">Receptionist</option>
                            <option value="doctor">Doctor</option>
                            <option value="owner">Clinic Owner</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label><i class="fas fa-user"></i> Username</label>
                        <input type="text" name="Username" placeholder="Enter username" required />
                    </div>
                    <div class="form-group">
                        <label><i class="fas fa-lock"></i> Password</label>
                        <input type="password" name="Password" placeholder="Enter password" required />
                    </div>
                    <div class="remember-row">
                        <label class="checkbox-label">
                            <input type="checkbox" name="RememberMe" />
                            <span>Remember me</span>
                        </label>
                        <a href="#" class="forgot-link">
                            <i class="fas fa-question-circle"></i> Forgot Password?
                        </a>
                    </div>
                    <button type="submit" class="btn-login">
                        <i class="fas fa-sign-in-alt"></i> Login
                    </button>
                    <div class="divider">
                        <span>OR</span>
                    </div>
                    <div class="contact-admin">
                        <p>
                            <i class="fas fa-user-plus"></i> Don't have an account?
                            <a href="#"><i class="fas fa-envelope"></i> Contact Administrator</a>
                        </p>
                    </div>
                </form>
            </div>

            <div class="login-footer">
                <p><i class="far fa-copyright"></i> 2026 MediCore Clinic Management System. All rights reserved.</p>
            </div>
        </div>
    </div>
</body>
</html>