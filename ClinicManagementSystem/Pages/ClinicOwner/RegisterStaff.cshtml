@page
@model ClinicManagementSystem.Pages.ClinicOwner.RegisterStaffModel
@{
    Layout = "_ClinicOwnerLayout";
    ViewData["Title"] = "Staff Management - MediCore";
}

<style>
    /* Keep all your existing CSS styles exactly as they are */
    .top-bar {
        background: white;
        border-radius: 12px;
        padding: 20px 25px;
        margin-bottom: 25px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        box-shadow: 0 2px 5px rgba(0,0,0,0.05);
    }

    .welcome-text h1 {
        font-size: 24px;
        color: #1a56db;
        margin-bottom: 5px;
    }

    .welcome-text p {
        color: #6c757d;
        font-size: 14px;
    }

    .date-time {
        background: #e8f0fe;
        padding: 8px 15px;
        border-radius: 8px;
        font-size: 13px;
        color: #1a56db;
    }

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 20px;
        margin-bottom: 25px;
    }

    .stat-card {
        background: white;
        border-radius: 12px;
        padding: 20px;
        box-shadow: 0 2px 5px rgba(0,0,0,0.05);
        transition: transform 0.2s;
    }

        .stat-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 5px 15px rgba(0,0,0,0.1);
        }

    .stat-number {
        font-size: 28px;
        font-weight: bold;
        color: #1a56db;
        margin-bottom: 5px;
    }

    .stat-label {
        color: #6c757d;
        font-size: 13px;
    }

    .two-columns {
        display: flex;
        gap: 25px;
    }

    .left-column {
        width: 450px;
        flex-shrink: 0;
    }

    .right-column {
        flex: 1;
    }

    .form-card {
        background: white;
        border-radius: 12px;
        box-shadow: 0 2px 5px rgba(0,0,0,0.05);
        overflow: hidden;
        margin-bottom: 25px;
    }

    .form-header {
        padding: 18px 20px;
        background: #1a56db;
        color: white;
    }

        .form-header h3 {
            font-size: 16px;
        }

    .form-body {
        padding: 20px;
    }

    .form-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 15px;
        margin-bottom: 10px;
    }

    .form-group {
        margin-bottom: 12px;
    }

    label {
        display: block;
        margin-bottom: 6px;
        font-weight: 600;
        color: #2d3748;
        font-size: 12px;
    }

    .required {
        color: #e53e3e;
    }

    input, select, textarea {
        width: 100%;
        padding: 8px 10px;
        border: 1px solid #ddd;
        border-radius: 8px;
        font-size: 13px;
        transition: all 0.3s;
    }

        input:focus, select:focus, textarea:focus {
            outline: none;
            border-color: #1a56db;
            box-shadow: 0 0 0 2px rgba(26,86,219,0.1);
        }

    .phone-input {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .phone-prefix {
        background: #f8f9fa;
        border: 1px solid #ddd;
        border-radius: 8px;
        padding: 8px 10px;
        font-size: 13px;
        color: #2d3748;
        white-space: nowrap;
    }

        .phone-prefix i {
            margin-right: 4px;
            color: #1a56db;
        }

    .phone-input input {
        flex: 1;
    }

    .age-display {
        background: #e8f0fe;
        padding: 8px 10px;
        border-radius: 8px;
        font-size: 13px;
        color: #1a56db;
    }

    .btn-group {
        display: flex;
        gap: 10px;
        margin-top: 15px;
    }

    .btn-submit, .btn-update {
        flex: 1;
        padding: 10px;
        background: #1a56db;
        color: white;
        border: none;
        border-radius: 8px;
        cursor: pointer;
        font-size: 14px;
        font-weight: 600;
    }

    .btn-cancel {
        flex: 1;
        padding: 10px;
        background: #e8f0fe;
        color: #2d3748;
        border: none;
        border-radius: 8px;
        cursor: pointer;
        font-size: 14px;
    }

    .card {
        background: white;
        border-radius: 12px;
        box-shadow: 0 2px 5px rgba(0,0,0,0.05);
        overflow: hidden;
    }

    .card-header {
        padding: 15px 20px;
        border-bottom: 1px solid #e8f0fe;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 15px;
    }

        .card-header h3 {
            font-size: 16px;
            color: #2d3748;
        }

    .search-filter {
        display: flex;
        gap: 10px;
        align-items: center;
    }

        .search-filter input {
            padding: 8px 12px;
            border: 1px solid #ddd;
            border-radius: 8px;
            width: 250px;
        }

        .search-filter button {
            padding: 8px 15px;
            background: #1a56db;
            color: white;
            border: none;
            border-radius: 8px;
            cursor: pointer;
        }

    .staff-table {
        width: 100%;
        border-collapse: collapse;
    }

        .staff-table th {
            text-align: left;
            padding: 12px 10px;
            background: #f8f9fa;
            font-size: 11px;
            color: #6c757d;
            font-weight: 600;
            border-bottom: 1px solid #e8f0fe;
        }

        .staff-table td {
            padding: 12px 10px;
            border-bottom: 1px solid #e8f0fe;
            font-size: 12px;
        }

        .staff-table tr:hover td {
            background: #f8f9fa;
        }

    .staff-avatar {
        width: 35px;
        height: 35px;
        background: #1a56db;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-weight: bold;
        font-size: 12px;
    }

    .status-badge {
        display: inline-block;
        padding: 3px 8px;
        border-radius: 20px;
        font-size: 10px;
        font-weight: 600;
    }

    .status-active {
        background: #e8fce8;
        color: #27ae60;
    }

    .status-inactive {
        background: #fee2e2;
        color: #e53e3e;
    }

    .action-buttons {
        display: flex;
        gap: 5px;
    }

    .edit-btn, .delete-btn {
        background: none;
        border: none;
        cursor: pointer;
        font-size: 14px;
        padding: 5px;
    }

    .edit-btn {
        color: #1a56db;
    }

    .delete-btn {
        color: #e53e3e;
    }

    .table-footer {
        padding: 12px 20px;
        border-top: 1px solid #e8f0fe;
        text-align: center;
        font-size: 12px;
        color: #6c757d;
    }

    .alert-success {
        background: #e8fce8;
        border-left: 4px solid #27ae60;
        padding: 12px 15px;
        margin-bottom: 20px;
        border-radius: 8px;
        color: #27ae60;
    }

    .alert-error {
        background: #fee2e2;
        border-left: 4px solid #e53e3e;
        padding: 12px 15px;
        margin-bottom: 20px;
        border-radius: 8px;
        color: #e53e3e;
    }
</style>

<div class="top-bar">
    <div class="welcome-text">
        <h1>Staff Management</h1>
        <p>Add, edit and manage staff members in the clinic</p>
    </div>
    <div class="date-time" id="dateTime"></div>
</div>

@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <div class="alert-success">
        <i class="fas fa-check-circle"></i> @Model.SuccessMessage
    </div>
}

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert-error">
        <i class="fas fa-exclamation-circle"></i> @Model.ErrorMessage
    </div>
}

<div class="stats-grid">
    <div class="stat-card">
        <div class="stat-number">@Model.TotalStaffCount</div>
        <div class="stat-label">Total Staff</div>
    </div>
    <div class="stat-card">
        <div class="stat-number">@Model.ActiveStaffCount</div>
        <div class="stat-label">Active Staff</div>
    </div>
    <div class="stat-card">
        <div class="stat-number">@Model.InactiveStaffCount</div>
        <div class="stat-label">Inactive Staff</div>
    </div>
    <div class="stat-card">
        <div class="stat-number">@Model.TotalDepartmentsCount</div>
        <div class="stat-label">Departments</div>
    </div>
</div>

<div class="two-columns">
    <div class="left-column">
        <div id="addPanel" class="form-card">
            <div class="form-header">
                <h3><i class="fas fa-plus-circle"></i> Add New Staff</h3>
            </div>
            <div class="form-body">
                <form method="post" asp-page-handler="AddStaff">
                    <div class="form-group">
                        <label>Full Name <span class="required">*</span></label>
                        <input type="text" asp-for="FullName" placeholder="Enter full name" required />
                    </div>
                    <div class="form-group">
                        <label>CNIC <span class="required">*</span></label>
                        <input type="text" asp-for="Cnic" placeholder="3520212345671" required />
                        <small style="font-size: 11px; color: #6c757d;">13 digits without spaces or dashes</small>
                    </div>
                    <div class="form-group">
                        <label>Email <span class="required">*</span></label>
                        <input type="email" asp-for="Email" placeholder="Enter email address" required />
                    </div>
                    <div class="form-group">
                        <label>Phone Number <span class="required">*</span></label>
                        <div class="phone-input">
                            <div class="phone-prefix">
                                <i class="fas fa-phone"></i> +92
                            </div>
                            <input type="tel" asp-for="Phone" placeholder="3XXXXXXXXX" required />
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group">
                            <label>Date of Birth <span class="required">*</span></label>
                            <input type="date" asp-for="DateOfBirth" required />
                        </div>
                        <div class="form-group">
                            <label>Gender <span class="required">*</span></label>
                            <select asp-for="Gender" required>
                                <option value="">Select gender</option>
                                <option>Male</option>
                                <option>Female</option>
                                <option>Other</option>
                            </select>
                        </div>
                    </div>
                    <div class="form-group">
                        <label>Joining Date <span class="required">*</span></label>
                        <input type="date" asp-for="JoiningDate" required />
                    </div>
                    <div class="form-group">
                        <label>Qualification <span class="required">*</span></label>
                        <input type="text" asp-for="Qualification" placeholder="Enter qualification" required />
                    </div>
                    <div class="form-group">
                        <label>Salary (Rs.) <span class="required">*</span></label>
                        <input type="number" asp-for="Salary" placeholder="Enter salary" min="0" required />
                    </div>
                    <div class="form-group">
                        <label>Address</label>
                        <textarea asp-for="Address" rows="2" placeholder="Enter full address"></textarea>
                    </div>
                    <div class="form-group">
                        <label>Status <span class="required">*</span></label>
                        <select asp-for="Status" required>
                            <option value="Active">Active</option>
                            <option value="Inactive">Inactive</option>
                        </select>
                    </div>
                    <div class="btn-group">
                        <button type="button" class="btn-cancel" onclick="clearForm()">Cancel</button>
                        <button type="submit" class="btn-submit">Add Staff</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="right-column">
        <div class="card">
            <div class="card-header">
                <h3><i class="fas fa-list"></i> Staff List</h3>
                <div class="search-filter">
                    <input type="text" id="searchInput" placeholder="Search by name, email or phone..." onkeyup="searchStaff()" />
                    <button onclick="searchStaff()"><i class="fas fa-search"></i> Search</button>
                </div>
            </div>
            <table class="staff-table">
                <thead>
                    <tr>
                        <th></th>
                        <th>Staff</th>
                        <th>Designation</th>
                        <th>Age</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>Joining Date</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody id="staffListBody">
                    @if (Model.StaffList != null && Model.StaffList.Any())
                    {
                        @foreach (var staff in Model.StaffList)
                        {
                            string initials = GetInitials(staff.FirstName, staff.LastName);
                            string statusClass = staff.Status == "Active" ? "status-active" : "status-inactive";
                            <tr>
                                <td><div class="staff-avatar">@initials</div></td>
                                <td><strong>@staff.FirstName @staff.LastName</strong></td>
                                <td>@(staff.Education ?? "Staff")</td>
                                <td>@staff.Age</td>
                                <td>@staff.Email</td>
                                <td>+92 @staff.ContactInfo</td>
                                <td>@staff.DateOfJoining.ToString("dd MMM yyyy")</td>
                                <td><span class="status-badge @statusClass">@staff.Status</span></td>
                                <td class="action-buttons">
                                    <button class="delete-btn" onclick="deleteStaff(@staff.ReceptionistId, '@staff.FirstName @staff.LastName')"><i class="fas fa-trash"></i></button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9" style="text-align:center; padding:30px;">No staff members found</td>
                        </tr>
                    }
                </tbody>
            </table>
            <div class="table-footer">
                Showing @(Model.StaffList?.Count ?? 0) of @Model.TotalStaffCount staff
            </div>
        </div>
    </div>
</div>

<script>
    function searchStaff() {
        const searchTerm = document.getElementById('searchInput').value;
        
        fetch(`/ClinicOwner/RegisterStaff?handler=SearchStaff&searchTerm=${encodeURIComponent(searchTerm)}`)
            .then(response => response.json())
            .then(data => {
                const tbody = document.getElementById('staffListBody');
                tbody.innerHTML = '';
                
                if (data.length === 0) {
                    tbody.innerHTML = '<tr><td colspan="9" style="text-align:center; padding:30px;">No staff members found</td></tr>';
                    document.querySelector('.table-footer').innerHTML = 'Showing 0 of 0 staff';
                    return;
                }
                
                data.forEach(staff => {
                    const row = tbody.insertRow();
                    const statusClass = staff.status === 'Active' ? 'status-active' : 'status-inactive';
                    
                    row.innerHTML = `
                        <td><div class="staff-avatar">${staff.initials}</div></td>
                        <td><strong>${staff.name}</strong></td>
                        <td>${staff.designation}</td>
                        <td>${staff.age}</td>
                        <td>${staff.email}</td>
                        <td>+92 ${staff.phone}</td>
                        <td>${new Date(staff.joiningDate).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}</td>
                        <td><span class="status-badge ${statusClass}">${staff.status}</span></td>
                        <td class="action-buttons">
                            <button class="delete-btn" onclick="deleteStaff(${staff.staffId}, '${staff.name}')"><i class="fas fa-trash"></i></button>
                        </td>
                    `;
                });
                
                document.querySelector('.table-footer').innerHTML = `Showing ${data.length} of ${data.length} staff`;
            })
            .catch(error => {
                console.error('Error searching staff:', error);
            });
    }
    
    function deleteStaff(id, name) {
        if (confirm(`Are you sure you want to delete ${name}?`)) {
            const form = document.createElement('form');
            form.method = 'post';
            form.action = `/ClinicOwner/RegisterStaff?handler=DeleteStaff&id=${id}`;
            document.body.appendChild(form);
            form.submit();
        }
    }
    
    function clearForm() {
        document.querySelector('input[asp-for="FullName"]').value = '';
        document.querySelector('input[asp-for="Email"]').value = '';
        document.querySelector('input[asp-for="Phone"]').value = '';
        document.querySelector('input[asp-for="DateOfBirth"]').value = '';
        document.querySelector('select[asp-for="Gender"]').value = '';
        document.querySelector('input[asp-for="JoiningDate"]').value = new Date().toISOString().split('T')[0];
        document.querySelector('input[asp-for="Qualification"]').value = '';
        document.querySelector('input[asp-for="Salary"]').value = '';
        document.querySelector('textarea[asp-for="Address"]').value = '';
        document.querySelector('select[asp-for="Status"]').value = 'Active';
    }
    
    function updateDateTime() {
        const now = new Date();
        const options = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' };
        document.getElementById('dateTime').innerHTML = now.toLocaleDateString('en-US', options);
    }
    
    updateDateTime();
    setInterval(updateDateTime, 1000);
    
    // Set default joining date to today
    const joiningDateInput = document.querySelector('input[asp-for="JoiningDate"]');
    if (joiningDateInput && !joiningDateInput.value) {
        joiningDateInput.value = new Date().toISOString().split('T')[0];
    }
</script>

@functions {
    public string GetInitials(string firstName, string lastName)
    {
        if (string.IsNullOrWhiteSpace(firstName)) return "ST";
        string initial1 = firstName[0].ToString().ToUpper();
        string initial2 = string.IsNullOrWhiteSpace(lastName) ? "F" : lastName[0].ToString().ToUpper();
        return initial1 + initial2;
    }
}