@page
@model ClinicManagementSystem.Pages.ClinicOwner.ReportsModel
@{
    Layout = "_ClinicOwnerLayout";
    ViewData["Title"] = "Reports - MediCore";
}

<style>
    .top-bar {
        background: white;
        border-radius: 12px;
        padding: 20px 25px;
        margin-bottom: 25px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        box-shadow: 0 2px 5px rgba(0,0,0,0.05);
    }

    .welcome-text h1 {
        font-size: 24px;
        color: #1a56db;
        margin-bottom: 5px;
    }

    .welcome-text p {
        color: #6c757d;
        font-size: 14px;
    }

    .date-time {
        background: #e8f0fe;
        padding: 8px 15px;
        border-radius: 8px;
        font-size: 13px;
        color: #1a56db;
    }

    .card {
        background: white;
        border-radius: 12px;
        box-shadow: 0 2px 5px rgba(0,0,0,0.05);
        overflow: hidden;
        margin-bottom: 25px;
    }

    .card-header {
        padding: 18px 20px;
        border-bottom: 1px solid #e8f0fe;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 15px;
    }

        .card-header h3 {
            font-size: 16px;
            color: #2d3748;
        }

    .card-body {
        padding: 20px;
    }

    .filter-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 15px;
        margin-bottom: 20px;
    }

    .filter-group label {
        display: block;
        font-size: 12px;
        color: #6c757d;
        margin-bottom: 5px;
        font-weight: 600;
    }

    .filter-group input, .filter-group select {
        width: 100%;
        padding: 8px 10px;
        border: 1px solid #ddd;
        border-radius: 8px;
        font-size: 13px;
    }

    .date-range {
        display: flex;
        gap: 10px;
    }

        .date-range input {
            flex: 1;
        }

    .format-options {
        display: flex;
        gap: 20px;
        margin: 15px 0;
    }

    .format-option {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .additional-filters {
        margin: 15px 0;
        display: flex;
        gap: 20px;
        flex-wrap: wrap;
    }

    .checkbox-option {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .btn-reset {
        padding: 8px 20px;
        background: #e8f0fe;
        color: #2d3748;
        border: none;
        border-radius: 8px;
        cursor: pointer;
    }

    .btn-generate {
        padding: 8px 20px;
        background: #1a56db;
        color: white;
        border: none;
        border-radius: 8px;
        cursor: pointer;
    }

    .report-table {
        width: 100%;
        border-collapse: collapse;
    }

        .report-table th {
            text-align: left;
            padding: 12px 12px;
            background: #f8f9fa;
            font-size: 12px;
            color: #6c757d;
            font-weight: 600;
            border-bottom: 1px solid #e8f0fe;
        }

        .report-table td {
            padding: 12px 12px;
            border-bottom: 1px solid #e8f0fe;
            font-size: 12px;
        }

        .report-table tr:hover td {
            background: #f8f9fa;
        }

    .status-completed {
        background: #e8fce8;
        color: #27ae60;
        padding: 3px 8px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 600;
        display: inline-block;
    }

    .action-icon {
        color: #1a56db;
        cursor: pointer;
        font-size: 16px;
    }

    .search-filter {
        display: flex;
        gap: 10px;
        align-items: center;
    }

        .search-filter input {
            padding: 8px 12px;
            border: 1px solid #ddd;
            border-radius: 8px;
            width: 250px;
        }

        .search-filter button {
            padding: 8px 15px;
            background: #1a56db;
            color: white;
            border: none;
            border-radius: 8px;
            cursor: pointer;
        }

    .table-footer {
        padding: 12px 20px;
        border-top: 1px solid #e8f0fe;
        text-align: center;
        font-size: 12px;
        color: #6c757d;
    }
</style>

<div class="top-bar">
    <div class="welcome-text">
        <h1>Reports</h1>
        <p>Generate and analyze reports to monitor clinic performance</p>
    </div>
    <div class="date-time" id="dateTime"></div>
</div>

<div class="card">
    <div class="card-header">
        <h3><i class="fas fa-chart-bar"></i> Generate Report</h3>
    </div>
    <div class="card-body">
        <div class="filter-grid">
            <div class="filter-group">
                <label>Report Type</label>
                <select id="reportType">
                    <option>Patient Report</option>
                    <option>Appointment Report</option>
                    <option>Financial Report</option>
                    <option>Payment Report</option>
                </select>
            </div>
            <div class="filter-group">
                <label>Date Range</label>
                <div class="date-range">
                    <input type="date" id="fromDate" value="2026-05-01" />
                    <input type="date" id="toDate" value="2026-05-16" />
                </div>
            </div>
            <div class="filter-group">
                <label>Group By</label>
                <select id="groupBy">
                    <option>Day</option>
                    <option>Week</option>
                    <option>Month</option>
                </select>
            </div>
            <div class="filter-group">
                <label>Doctor</label>
                <select id="doctor">
                    <option>All Doctors</option>
                    <option>Dr. Sarah Khan</option>
                    <option>Dr. Ali Raza</option>
                    <option>Dr. Ahmed Malik</option>
                </select>
            </div>
            <div class="filter-group">
                <label>Payment Type</label>
                <select id="paymentType">
                    <option>All Payment Types</option>
                    <option>Cash</option>
                    <option>UPI</option>
                    <option>Card</option>
                </select>
            </div>
            <div class="filter-group">
                <label>Status</label>
                <select id="status">
                    <option>All Status</option>
                    <option>Completed</option>
                    <option>Pending</option>
                    <option>Cancelled</option>
                </select>
            </div>
            <div class="filter-group">
                <label>Gender</label>
                <select id="gender">
                    <option>All</option>
                    <option>Male</option>
                    <option>Female</option>
                </select>
            </div>
            <div class="filter-group">
                <label>Age Range</label>
                <select id="ageRange">
                    <option>All</option>
                    <option>0-18</option>
                    <option>19-35</option>
                    <option>36-50</option>
                    <option>51+</option>
                </select>
            </div>
        </div>

        <div class="additional-filters">
            <label class="checkbox-option">
                <input type="checkbox" id="includeInactive" /> Include Inactive Records
            </label>
            <label class="checkbox-option">
                <input type="checkbox" id="includeCancelled" /> Include Cancelled Records
            </label>
        </div>

        <div class="format-options">
            <label class="format-option">
                <input type="radio" name="format" value="screen" checked /> On Screen
            </label>
            <label class="format-option">
                <input type="radio" name="format" value="pdf" /> PDF
            </label>
            <label class="format-option">
                <input type="radio" name="format" value="excel" /> Excel
            </label>
        </div>

        <div style="display: flex; gap: 10px; justify-content: flex-end;">
            <button class="btn-reset" onclick="resetFilters()">Reset</button>
            <button class="btn-generate" onclick="generateReport()">Generate Report</button>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <h3><i class="fas fa-history"></i> Recent Reports</h3>
        <div class="search-filter">
            <input type="text" id="searchReport" placeholder="Search reports by name..." onkeyup="filterReports()" />
            <button onclick="filterReports()">Filter</button>
        </div>
    </div>
    <table class="report-table">
        <thead>
            <tr>
                <th>Report Name</th>
                <th>Report Type</th>
                <th>Date Range</th>
                <th>Generated On</th>
                <th>Generated By</th>
                <th>Format</th>
                <th>Status</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody id="reportsBody"></tbody>
    </table>
    <div class="table-footer" id="reportFooter">Showing 1 to 8 of 8 reports</div>
</div>

<script>
    let reports = [
        { name: "Patient Register", type: "Patient Report", fromDate: "May 1, 2026", toDate: "May 16, 2026", generatedOn: "May 16, 2026 10:30 AM", generatedBy: "Admin", format: "PDF", status: "Completed" },
        { name: "Appointment Summary", type: "Appointment Report", fromDate: "May 1, 2026", toDate: "May 16, 2026", generatedOn: "May 16, 2026 09:15 AM", generatedBy: "Admin", format: "Excel", status: "Completed" },
        { name: "Revenue Report", type: "Financial Report", fromDate: "May 1, 2026", toDate: "May 15, 2026", generatedOn: "May 16, 2026 08:45 AM", generatedBy: "Admin", format: "PDF", status: "Completed" },
        { name: "Payment Summary", type: "Payment Report", fromDate: "May 1, 2026", toDate: "May 16, 2026", generatedOn: "May 15, 2026 06:20 PM", generatedBy: "Admin", format: "Excel", status: "Completed" },
        { name: "Cancelled Appointments", type: "Appointment Report", fromDate: "May 1, 2026", toDate: "May 16, 2026", generatedOn: "May 15, 2026 02:20 PM", generatedBy: "Admin", format: "PDF", status: "Completed" },
        { name: "Patient Visit Summary", type: "Patient Report", fromDate: "May 1, 2026", toDate: "May 16, 2026", generatedOn: "May 14, 2026 11:45 AM", generatedBy: "Admin", format: "Excel", status: "Completed" },
        { name: "Monthly Collection Report", type: "Financial Report", fromDate: "May 1, 2026", toDate: "May 16, 2026", generatedOn: "May 14, 2026 09:30 AM", generatedBy: "Admin", format: "PDF", status: "Completed" },
        { name: "Department Wise Summary", type: "Staff Report", fromDate: "May 1, 2026", toDate: "May 16, 2026", generatedOn: "May 13, 2026 04:15 PM", generatedBy: "Admin", format: "Excel", status: "Completed" }
    ];

    function renderReports() {
        const tbody = document.getElementById('reportsBody');
        const searchTerm = document.getElementById('searchReport').value.toLowerCase();
        let filtered = reports;
        if (searchTerm) {
            filtered = reports.filter(r => r.name.toLowerCase().includes(searchTerm));
        }
        tbody.innerHTML = '';
        filtered.forEach(r => {
            const row = tbody.insertRow();
            row.innerHTML = `
                <td><strong>${r.name}</strong></td>
                <td>${r.type}</td>
                <td>${r.fromDate} - ${r.toDate}</td>
                <td>${r.generatedOn}</td>
                <td>${r.generatedBy}</td>
                <td>${r.format}</td>
                <td><span class="status-completed">${r.status}</span></td>
                <td><i class="fas fa-download action-icon" onclick="downloadReport('${r.name}')"></i></td>
            `;
        });
        document.getElementById('reportFooter').innerHTML = `Showing 1 to ${filtered.length} of ${reports.length} reports`;
    }

    function filterReports() {
        renderReports();
    }

    function resetFilters() {
        document.getElementById('reportType').value = 'Patient Report';
        document.getElementById('fromDate').value = '2026-05-01';
        document.getElementById('toDate').value = '2026-05-16';
        document.getElementById('groupBy').value = 'Day';
        document.getElementById('doctor').value = 'All Doctors';
        document.getElementById('paymentType').value = 'All Payment Types';
        document.getElementById('status').value = 'All Status';
        document.getElementById('gender').value = 'All';
        document.getElementById('ageRange').value = 'All';
        document.getElementById('includeInactive').checked = false;
        document.getElementById('includeCancelled').checked = false;
    }
    function generateReport() {
        alert(`Report generated successfully!`);
    }
    function downloadReport(name) {
        alert(`Downloading ${name}...`);
    }
    function updateDateTime() {
        const now = new Date();
        const options = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' };
        document.getElementById('dateTime').innerHTML = now.toLocaleDateString('en-US', options);
    }
    updateDateTime();
    setInterval(updateDateTime, 1000);
    renderReports();
</script>