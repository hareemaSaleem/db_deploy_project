@page
@model ClinicManagementSystem.Pages.ClinicOwner.SettingsModel
@{
    Layout = "_ClinicOwnerLayout";
    ViewData["Title"] = "Settings - MediCore";
}

<style>
    .top-bar {
        background: white;
        border-radius: 12px;
        padding: 20px 25px;
        margin-bottom: 25px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        box-shadow: 0 2px 5px rgba(0,0,0,0.05);
    }
    .welcome-text h1 {
        font-size: 24px;
        color: #1a56db;
        margin-bottom: 5px;
    }
    .welcome-text p {
        color: #6c757d;
        font-size: 14px;
    }
    .date-time {
        background: #e8f0fe;
        padding: 8px 15px;
        border-radius: 8px;
        font-size: 13px;
        color: #1a56db;
    }
    .card {
        background: white;
        border-radius: 12px;
        box-shadow: 0 2px 5px rgba(0,0,0,0.05);
        overflow: hidden;
        margin-bottom: 25px;
    }
    .card-header {
        padding: 18px 20px;
        background: #1a56db;
        color: white;
    }

        .card-header h3 {
            font-size: 16px;
        }

    .card-body {
        padding: 25px;
    }
    .form-group {
        margin-bottom: 20px;
    }
    .form-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
        margin-bottom: 20px;
    }
    label {
        display: block;
        margin-bottom: 8px;
        font-weight: 600;
        color: #2d3748;
        font-size: 13px;
    }

    input, select {
        width: 100%;
        padding: 10px 12px;
        border: 1px solid #ddd;
        border-radius: 8px;
        font-size: 14px;
        transition: all 0.3s;
    }

        input:focus, select:focus {
            outline: none;
            border-color: #1a56db;
            box-shadow: 0 0 0 2px rgba(26,86,219,0.1);
        }

    .preference-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 12px 0;
        border-bottom: 1px solid #e8f0fe;
    }

    .preference-label {
        font-weight: 600;
        color: #2d3748;
        font-size: 14px;
    }

    .preference-value {
        color: #1a56db;
        font-weight: 500;
    }

    .btn-save {
        padding: 12px 30px;
        background: #1a56db;
        color: white;
        border: none;
        border-radius: 8px;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        margin-top: 10px;
    }

        .btn-save:hover {
            background: #0e3fad;
        }

    .mode-options {
        display: flex;
        gap: 20px;
        margin-top: 15px;
    }

    .mode-card {
        flex: 1;
        border: 2px solid #e8f0fe;
        border-radius: 12px;
        padding: 20px;
        text-align: center;
        cursor: pointer;
        transition: all 0.3s;
    }

        .mode-card.selected {
            border-color: #1a56db;
            background: #e8f0fe;
        }

        .mode-card:hover {
            border-color: #1a56db;
        }

    .mode-icon {
        font-size: 48px;
        color: #1a56db;
        margin-bottom: 10px;
    }

    .mode-title {
        font-weight: 600;
        color: #2d3748;
        margin-bottom: 5px;
    }

    .mode-desc {
        font-size: 12px;
        color: #6c757d;
    }
</style>

<div class="top-bar">
    <div class="welcome-text">
        <h1>Settings</h1>
        <p>Manage your clinic information, preferences and settings</p>
    </div>
    <div class="date-time" id="dateTime"></div>
</div>

<div class="card">
    <div class="card-header">
        <h3><i class="fas fa-hospital-user"></i> Clinic Information</h3>
    </div>
    <div class="card-body">
        <div class="form-row">
            <div class="form-group">
                <label>Clinic Name</label>
                <input type="text" id="clinicName" value="City Care Clinic" />
            </div>
            <div class="form-group">
                <label>Email</label>
                <input type="email" id="clinicEmail" value="info@citycareclinic.com" />
            </div>
        </div>
        <div class="form-row">
            <div class="form-group">
                <label>Phone</label>
                <input type="text" id="clinicPhone" value="+92 300 1234567" />
            </div>
            <div class="form-group">
                <label>City</label>
                <input type="text" id="clinicCity" value="Lahore" />
            </div>
        </div>
        <div class="form-group">
            <label>Address</label>
            <input type="text" id="clinicAddress" value="123 Main Street, Gulberg, Lahore, Pakistan" />
        </div>
        <div class="form-group">
            <label>Zip / Postal Code</label>
            <input type="text" id="clinicZip" value="54000" />
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <h3><i class="fas fa-palette"></i> Appearance (Mode)</h3>
    </div>
    <div class="card-body">
        <p style="font-size: 13px; color: #6c757d; margin-bottom: 15px;">Choose your preferred application mode.</p>
        <div class="mode-options">
            <div class="mode-card" id="lightMode" data-theme="Light">
                <div class="mode-icon"><i class="fas fa-sun"></i></div>
                <div class="mode-title">Light Mode</div>
                <div class="mode-desc">Use light theme</div>
            </div>
            <div class="mode-card" id="darkMode" data-theme="Dark">
                <div class="mode-icon"><i class="fas fa-moon"></i></div>
                <div class="mode-title">Dark Mode</div>
                <div class="mode-desc">Use dark theme</div>
            </div>
        </div>
    </div>
</div>

<script>
    // Get current theme from Model
    let currentTheme = '@Model.Settings.ThemeMode';
    
    // Highlight selected theme
    function highlightSelectedTheme() {
        const lightCard = document.getElementById('lightMode');
        const darkCard = document.getElementById('darkMode');
        
        if (currentTheme === 'Light') {
            lightCard.classList.add('selected');
            darkCard.classList.remove('selected');
        } else if (currentTheme === 'Dark') {
            darkCard.classList.add('selected');
            lightCard.classList.remove('selected');
        } else {
            lightCard.classList.add('selected');
        }
    }
    
    // Apply theme to whole page
    function applyThemeToPage(theme) {
        const body = document.body;
        
        if (theme === 'Dark') {
            body.classList.add('dark-mode');
            // Also update the toggle button in layout if exists
            const themeIcon = document.getElementById('themeIcon');
            const themeText = document.getElementById('themeText');
            if (themeIcon) themeIcon.className = 'fas fa-sun';
            if (themeText) themeText.textContent = 'Light Mode';
        } else {
            body.classList.remove('dark-mode');
            const themeIcon = document.getElementById('themeIcon');
            const themeText = document.getElementById('themeText');
            if (themeIcon) themeIcon.className = 'fas fa-moon';
            if (themeText) themeText.textContent = 'Dark Mode';
        }
        
        // Save to localStorage
        localStorage.setItem('theme', theme);
        
        // Save to cookie
        document.cookie = `ThemeMode=${theme}; path=/; expires=${new Date(Date.now() + 365 * 24 * 60 * 60 * 1000).toUTCString()}`;
    }
    
    // Save theme to database
    async function saveThemeToDatabase(theme) {
        try {
            const response = await fetch('/ClinicOwner/Settings?handler=SetTheme&theme=' + theme, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                }
            });
            const result = await response.json();
            if (result.success) {
                console.log('Theme saved to database:', theme);
                currentTheme = theme;
                highlightSelectedTheme();
            }
        } catch (error) {
            console.error('Error saving theme:', error);
        }
    }
    
    // Light Mode Click Handler
    document.getElementById('lightMode').addEventListener('click', function() {
        const theme = 'Light';
        applyThemeToPage(theme);
        saveThemeToDatabase(theme);
    });
    
    // Dark Mode Click Handler
    document.getElementById('darkMode').addEventListener('click', function() {
        const theme = 'Dark';
        applyThemeToPage(theme);
        saveThemeToDatabase(theme);
    });
    
    // Apply saved theme on page load
    function loadSavedTheme() {
        // Check localStorage first
        let theme = localStorage.getItem('theme');
        if (!theme) {
            // Check cookie
            const cookies = document.cookie.split(';');
            for (let i = 0; i < cookies.length; i++) {
                const cookie = cookies[i].trim();
                if (cookie.startsWith('ThemeMode=')) {
                    theme = cookie.substring('ThemeMode='.length);
                    break;
                }
            }
        }
        
        if (theme === 'Dark') {
            applyThemeToPage('Dark');
        } else {
            applyThemeToPage('Light');
        }
        
        highlightSelectedTheme();
    }
    
    // Initialize
    loadSavedTheme();
    
    // Rest of your existing functions...
    function updateDateTime() {
        const now = new Date();
        const options = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' };
        const dateTimeElement = document.getElementById('dateTime');
        if (dateTimeElement) {
            dateTimeElement.innerHTML = now.toLocaleDateString('en-US', options);
        }
    }
    
    updateDateTime();
    setInterval(updateDateTime, 1000);
</script>