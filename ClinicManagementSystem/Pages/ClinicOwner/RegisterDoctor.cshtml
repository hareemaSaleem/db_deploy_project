@page
@model ClinicManagementSystem.Pages.ClinicOwner.RegisterDoctorModel
@{
    Layout = "_ClinicOwnerLayout";
    ViewData["Title"] = "Doctor Management - MediCore";
}

<style>
    .top-bar {
        background: white;
        border-radius: 12px;
        padding: 20px 25px;
        margin-bottom: 25px;
        box-shadow: 0 2px 5px rgba(0,0,0,0.05);
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .welcome-text h1 {
        font-size: 24px;
        color: #1a56db;
        margin-bottom: 5px;
    }

    .welcome-text p {
        color: #6c757d;
        font-size: 14px;
    }

    .date-time {
        background: #e8f0fe;
        padding: 8px 15px;
        border-radius: 8px;
        font-size: 13px;
        color: #1a56db;
    }

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 20px;
        margin-bottom: 25px;
    }

    .stat-card {
        background: white;
        border-radius: 12px;
        padding: 20px;
        box-shadow: 0 2px 5px rgba(0,0,0,0.05);
        transition: transform 0.2s;
    }

        .stat-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 5px 15px rgba(0,0,0,0.1);
        }

    .stat-number {
        font-size: 28px;
        font-weight: bold;
        color: #1a56db;
        margin-bottom: 5px;
    }

    .stat-label {
        color: #6c757d;
        font-size: 13px;
    }

    .two-columns {
        display: flex;
        gap: 25px;
    }

    .left-column {
        width: 400px;
        flex-shrink: 0;
    }

    .right-column {
        flex: 1;
    }

    .form-card {
        background: white;
        border-radius: 12px;
        box-shadow: 0 2px 5px rgba(0,0,0,0.05);
        overflow: hidden;
        margin-bottom: 25px;
    }

    .form-header {
        padding: 18px 20px;
        background: #1a56db;
        color: white;
    }

        .form-header h3 {
            font-size: 16px;
        }

    .form-body {
        padding: 20px;
    }

    .form-group {
        margin-bottom: 15px;
    }

    label {
        display: block;
        margin-bottom: 8px;
        font-weight: 600;
        color: #2d3748;
        font-size: 13px;
    }

    .required {
        color: #e53e3e;
    }

    input, select, textarea {
        width: 100%;
        padding: 10px 12px;
        border: 1px solid #ddd;
        border-radius: 8px;
        font-size: 14px;
        transition: all 0.3s;
    }

        input:focus, select:focus, textarea:focus {
            outline: none;
            border-color: #1a56db;
            box-shadow: 0 0 0 2px rgba(26,86,219,0.1);
        }

    .phone-input {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .phone-prefix {
        background: #f8f9fa;
        border: 1px solid #ddd;
        border-radius: 8px;
        padding: 10px 12px;
        font-size: 14px;
        color: #2d3748;
        white-space: nowrap;
    }

        .phone-prefix i {
            margin-right: 5px;
            color: #1a56db;
        }

    .phone-input input {
        flex: 1;
    }

    .btn-group {
        display: flex;
        gap: 10px;
        margin-top: 15px;
    }

    .btn-submit {
        flex: 1;
        padding: 10px;
        background: #1a56db;
        color: white;
        border: none;
        border-radius: 8px;
        cursor: pointer;
        font-size: 14px;
        font-weight: 600;
    }

    .btn-cancel {
        flex: 1;
        padding: 10px;
        background: #e8f0fe;
        color: #2d3748;
        border: none;
        border-radius: 8px;
        cursor: pointer;
        font-size: 14px;
    }

    .card {
        background: white;
        border-radius: 12px;
        box-shadow: 0 2px 5px rgba(0,0,0,0.05);
        overflow: hidden;
    }

    .card-header {
        padding: 18px 20px;
        border-bottom: 1px solid #e8f0fe;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 15px;
    }

        .card-header h3 {
            font-size: 16px;
            color: #2d3748;
        }

    .search-filter {
        display: flex;
        gap: 10px;
        align-items: center;
    }

        .search-filter input {
            padding: 8px 12px;
            border: 1px solid #ddd;
            border-radius: 8px;
            width: 250px;
        }

        .search-filter button {
            padding: 8px 15px;
            background: #1a56db;
            color: white;
            border: none;
            border-radius: 8px;
            cursor: pointer;
        }

    .doctor-table {
        width: 100%;
        border-collapse: collapse;
    }

        .doctor-table th {
            text-align: left;
            padding: 12px 15px;
            background: #f8f9fa;
            font-size: 12px;
            color: #6c757d;
            font-weight: 600;
            border-bottom: 1px solid #e8f0fe;
        }

        .doctor-table td {
            padding: 12px 15px;
            border-bottom: 1px solid #e8f0fe;
            font-size: 13px;
        }

        .doctor-table tr:hover td {
            background: #f8f9fa;
        }

    .doctor-avatar {
        width: 35px;
        height: 35px;
        background: #1a56db;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-weight: bold;
        font-size: 14px;
    }

    .status-badge {
        display: inline-block;
        padding: 4px 10px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 600;
    }

    .status-active {
        background: #e8fce8;
        color: #27ae60;
    }

    .status-inactive {
        background: #fee2e2;
        color: #e53e3e;
    }

    .action-buttons {
        display: flex;
        gap: 8px;
    }

    .edit-btn, .delete-btn {
        background: none;
        border: none;
        cursor: pointer;
        font-size: 14px;
        padding: 5px;
    }

    .edit-btn {
        color: #1a56db;
    }

    .delete-btn {
        color: #e53e3e;
    }

    .table-footer {
        padding: 12px 20px;
        border-top: 1px solid #e8f0fe;
        text-align: center;
        font-size: 12px;
        color: #6c757d;
    }

    .alert-success {
        background: #e8fce8;
        border-left: 4px solid #27ae60;
        padding: 12px 15px;
        margin-bottom: 20px;
        border-radius: 8px;
        color: #27ae60;
    }

    .alert-error {
        background: #fee2e2;
        border-left: 4px solid #e53e3e;
        padding: 12px 15px;
        margin-bottom: 20px;
        border-radius: 8px;
        color: #e53e3e;
    }
</style>

<div class="top-bar">
    <div class="welcome-text">
        <h1>Doctor Management</h1>
        <p>Add, edit and manage doctors in the clinic</p>
    </div>
    <div class="date-time" id="dateTime"></div>
</div>

@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <div class="alert-success">
        <i class="fas fa-check-circle"></i> @Model.SuccessMessage
    </div>
}

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert-error">
        <i class="fas fa-exclamation-circle"></i> @Model.ErrorMessage
    </div>
}

<div class="stats-grid">
    <div class="stat-card">
        <div class="stat-number">@Model.TotalDoctorsCount</div>
        <div class="stat-label">Total Doctors</div>
    </div>
    <div class="stat-card">
        <div class="stat-number">@Model.ActiveDoctorsCount</div>
        <div class="stat-label">Active Doctors</div>
    </div>
    <div class="stat-card">
        <div class="stat-number">@Model.InactiveDoctorsCount</div>
        <div class="stat-label">Inactive Doctors</div>
    </div>
    <div class="stat-card">
        <div class="stat-number">@Model.TotalSpecializationsCount</div>
        <div class="stat-label">Specializations</div>
    </div>
</div>

<div class="two-columns">
    <div class="left-column">
        <div class="form-card">
            <div class="form-header">
                <h3><i class="fas fa-plus-circle"></i> Add New Doctor</h3>
            </div>
            <div class="form-body">
                <form method="post" asp-page-handler="AddDoctor">
                    <div class="form-group">
                        <label>Full Name <span class="required">*</span></label>
                        <input type="text" asp-for="FullName" placeholder="Enter full name" required />
                    </div>
                    <div class="form-group">
                        <label>CNIC <span class="required">*</span></label>
                        <input type="text" asp-for="Cnic" placeholder="3520212345671" required />
                        <small style="font-size: 11px; color: #6c757d;">13 digits without spaces or dashes</small>
                    </div>
                    <div class="form-group">
                        <label>Specialization <span class="required">*</span></label>
                        <select asp-for="Specialization" required>
                            <option value="">Select specialization</option>
                            <option>General Physician</option>
                            <option>Cardiologist</option>
                            <option>Pediatrician</option>
                            <option>Orthopedic</option>
                            <option>Dermatologist</option>
                            <option>Neurologist</option>
                            <option>Gynecologist</option>
                            <option>ENT Specialist</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label>Email <span class="required">*</span></label>
                        <input type="email" asp-for="Email" placeholder="Enter email address" required />
                    </div>

                    <div class="form-group">
                        <label>Phone Number <span class="required">*</span></label>
                        <div class="phone-input">
                            <div class="phone-prefix">
                                <i class="fas fa-phone"></i> +92
                            </div>
                            <input type="tel" asp-for="Phone" placeholder="3XXXXXXXXX" required />
                        </div>
                    </div>

                    <div class="form-group">
                        <label>Qualification <span class="required">*</span></label>
                        <input type="text" asp-for="Qualification" placeholder="e.g., MBBS, FCPS, MD" required />
                    </div>

                    <div class="form-group">
                        <label>Experience (Years) <span class="required">*</span></label>
                        <input type="number" asp-for="Experience" placeholder="Enter years of experience" min="0" required />
                    </div>

                    <div class="form-group">
                        <label>Consultation Fee (Rs.) <span class="required">*</span></label>
                        <input type="number" asp-for="ConsultationFee" placeholder="Enter consultation fee" min="0" required />
                    </div>

                    <div class="form-group">
                        <label>Status <span class="required">*</span></label>
                        <select asp-for="Status" required>
                            <option value="Active">Active</option>
                            <option value="Inactive">Inactive</option>
                        </select>
                    </div>

                    <div class="btn-group">
                        <button type="button" class="btn-cancel" onclick="clearForm()">Cancel</button>
                        <button type="submit" class="btn-submit">Add Doctor</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="right-column">
        <div class="card">
            <div class="card-header">
                <h3><i class="fas fa-list"></i> Doctors List</h3>
                <div class="search-filter">
                    <input type="text" id="searchInput" placeholder="Search by name, email or phone..." onkeyup="searchDoctors()" />
                    <button onclick="searchDoctors()"><i class="fas fa-search"></i> Search</button>
                </div>
            </div>
            <table class="doctor-table" id="doctorsTable">
                <thead>
                    <tr>
                        <th></th>
                        <th>Doctor</th>
                        <th>Specialization</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody id="doctorsListBody">
                    @if (Model.DoctorsList != null && Model.DoctorsList.Any())
                    {
                        @foreach (var doctor in Model.DoctorsList)
                        {
                            string initials = GetInitials(doctor.Name);
                            string statusClass = doctor.Status == "Active" ? "status-active" : "status-inactive";
                            <tr>
                                <td><div class="doctor-avatar">@initials</div></td>
                                <td><strong>@doctor.Name</strong></td>
                                <td>@doctor.Specialization</td>
                                <td>@doctor.Email</td>
                                <td>+92 @doctor.Phone</td>
                                <td><span class="status-badge @statusClass">@doctor.Status</span></td>
                                <td class="action-buttons">
                                    <button class="delete-btn" onclick="deleteDoctor(@doctor.DoctorId, '@doctor.Name')"><i class="fas fa-trash"></i></button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" style="text-align:center; padding:30px;">No doctors found</td>
                        </tr>
                    }
                </tbody>
            </table>
            <div class="table-footer">
                Showing @(Model.DoctorsList?.Count ?? 0) of @Model.TotalDoctorsCount doctors
            </div>
        </div>
    </div>
</div>

<script>
    function searchDoctors() {
        const searchTerm = document.getElementById('searchInput').value;

        fetch(`/ClinicOwner/RegisterDoctor?handler=SearchDoctors&searchTerm=${encodeURIComponent(searchTerm)}`)
            .then(response => response.json())
            .then(data => {
                const tbody = document.getElementById('doctorsListBody');
                tbody.innerHTML = '';

                if (data.length === 0) {
                    tbody.innerHTML = '<tr><td colspan="7" style="text-align:center; padding:30px;">No doctors found</td></tr>';
                    document.querySelector('.table-footer').innerHTML = 'Showing 0 of 0 doctors';
                    return;
                }

                data.forEach(doctor => {
                    const row = tbody.insertRow();
                    const statusClass = doctor.status === 'Active' ? 'status-active' : 'status-inactive';

                    row.innerHTML = `
                        <td><div class="doctor-avatar">${doctor.initials}</div></td>
                        <td><strong>${doctor.name}</strong></br>
                        <td>${doctor.specialization}</br>
                        <td>${doctor.email}</br>
                        <td>+92 ${doctor.phone}</br>
                        <td><span class="status-badge ${statusClass}">${doctor.status}</span></br>
                        <td class="action-buttons">
                            <button class="delete-btn" onclick="deleteDoctor(${doctor.doctorId}, '${doctor.name}')"><i class="fas fa-trash"></i></button>
                        </td>
                    `;
                });

                document.querySelector('.table-footer').innerHTML = `Showing ${data.length} of ${data.length} doctors`;
            })
            .catch(error => {
                console.error('Error searching doctors:', error);
            });
    }

    function deleteDoctor(id, name) {
        if (confirm(`Are you sure you want to delete Dr. ${name}?`)) {
            const form = document.createElement('form');
            form.method = 'post';
            form.action = `/ClinicOwner/RegisterDoctor?handler=DeleteDoctor&id=${id}`;
            document.body.appendChild(form);
            form.submit();
        }
    }

    function clearForm() {
        document.querySelector('input[asp-for="FullName"]').value = '';
        document.querySelector('select[asp-for="Specialization"]').value = '';
        document.querySelector('input[asp-for="Email"]').value = '';
        document.querySelector('input[asp-for="Phone"]').value = '';
        document.querySelector('input[asp-for="Qualification"]').value = '';
        document.querySelector('input[asp-for="Experience"]').value = '';
        document.querySelector('input[asp-for="ConsultationFee"]').value = '';
        document.querySelector('select[asp-for="Status"]').value = 'Active';
    }

    function updateDateTime() {
        const now = new Date();
        const options = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' };
        const dateTimeElement = document.getElementById('dateTime');
        if (dateTimeElement) {
            dateTimeElement.innerHTML = now.toLocaleDateString('en-US', options);
        }
    }

    updateDateTime();
    setInterval(updateDateTime, 1000);
</script>

@functions {
    public string GetInitials(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "DR";
        var nameParts = name.Split(' ');
        if (nameParts.Length >= 2)
        {
            return (nameParts[0][0].ToString() + nameParts[1][0].ToString()).ToUpper();
        }
        else
        {
            return name.Substring(0, Math.Min(2, name.Length)).ToUpper();
        }
    }
}